---
import "../styles/global.css";
import ExternalRedirect from "../components/ExternalRedirect.astro";
import { ik } from "../lib/imagekit";

interface Props {
	title?: string;
	titleKey?: string;
	description?: string;
	/** Extra JSON-LD for this page (Article, FAQPage, …). Merged into the @graph below. */
	schema?: Record<string, unknown>[];
	/** Robots directive for pages that must stay out of the index, e.g. "noindex, follow". */
	robots?: string;
	/** Social preview image. Falls back to the logo for pages without one of their own. */
	image?: string;
	/** og:type — "article" for blog posts, "website" everywhere else. */
	ogType?: "website" | "article";
}
const {
	title = "Build a high-earning e-commerce store without owning inventory",
	titleKey,
	description = "Droparabia allows Lebanese entrepreneurs to build a successful e-commerce business without burning their budget on inventory, product shipping, or beginner mistakes.",
	schema = [],
	robots,
	image,
	ogType = "website",
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Derived from `site` rather than written out, so the entity ids can never drift from the
// host the canonicals use.
const origin = new URL(Astro.site!).origin;
const logo = ik("/Droparabia.webp", "w-512,q-90");
const socialImage = image ?? ik("/Droparabia.webp", "w-512,q-80");

// Entity definition for answer engines. This does not "rank" anything — Google states
// plainly that schema is not required for its AI features. What it does is pin down who
// Droparabia is, where it operates and who runs it, so a model resolving the name has an
// unambiguous machine-readable answer instead of inferring one.
// Keep every fact here true and in sync with the site copy.
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": `${origin}/#organization`,
			name: "Droparabia",
			url: `${origin}/`,
			logo,
			// Taken verbatim from the first FAQ answer. The previous description promised payouts
			// "within 24 hours of delivery", which appears nowhere on the site.
			description:
				"Droparabia is an e-commerce platform built specifically for Lebanon, designed to remove the biggest obstacles that make starting an online business difficult.",
			founder: { "@id": `${origin}/#founder` },
			areaServed: {
				"@type": "Country",
				name: "Lebanon",
			},
			// sameAs is how an engine confirms these profiles and this domain are one entity.
			// Canonical URLs only — tracking params would make them look like different pages.
			sameAs: [
				"https://www.instagram.com/mjbusinessofficial",
				"https://www.youtube.com/@mj.biznes",
				"https://www.trustpilot.com/review/droparabia.com",
				"https://apps.apple.com/us/app/droparabia/id6757470742",
				"https://play.google.com/store/apps/details?id=com.codergize.droparabia",
			],
		},
		{
			"@type": "WebSite",
			"@id": `${origin}/#website`,
			url: `${origin}/`,
			name: "Droparabia",
			publisher: { "@id": `${origin}/#organization` },
			inLanguage: "en",
		},
		// Its own node so the Organization (founder) and every blog post (author) can point at
		// one entity by @id instead of each restating him. Facts are from the About page and
		// the FAQ ("our founder, Majd"); the photo is the one the About page shows.
		{
			"@type": "Person",
			"@id": `${origin}/#founder`,
			name: "Majd Abdulsalam",
			jobTitle: "Founder",
			worksFor: { "@id": `${origin}/#organization` },
			image: ik("/mj.jpeg", "w-800,q-80"),
		},
		...schema,
	],
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/webp" href={ik("/Droparabia.webp", "w-64,q-90")} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title id="page-title" data-title-key={titleKey}>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{robots && <meta name="robots" content={robots} />}
		<link rel="preconnect" href="https://ik.imagekit.io" />

		<!-- Every webfont is self-hosted now (see the @font-face block in global.css), so the two
			 Google Fonts preconnects and the stylesheet they were warming are both gone — along
			 with the render-blocking request and the second origin hop each one cost. -->

		<!-- Ibrand renders the hero headline, i.e. the LCP text on most pages. Without this it
			 isn't discovered until global.css has been fetched and parsed, which measured ~500ms
			 in. Preloading starts it alongside the CSS instead. -->
		<link rel="preload" href="/fonts/ibrand/ibrand.woff2" as="font" type="font/woff2" crossorigin />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Droparabia" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={socialImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<!-- is:inline keeps Astro from treating this as a module to process/bundle — it is data,
			 not code. -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
		<script is:inline>
			const theme = localStorage.getItem("theme");
			if (theme === "dark") {
				document.documentElement.classList.add("dark");
			}
			const lang = localStorage.getItem("lang");
			if (lang === "ar" || lang === "fr") {
				document.documentElement.lang = lang;
				// Arabic is the only RTL language on offer — French stays LTR like English.
				document.documentElement.dir = lang === "ar" ? "rtl" : "ltr";
			}
		</script>
	</head>
	<body class="bg-background font-helvetica dark:bg-neutral-950">
		<slot />
		<ExternalRedirect />
	</body>
</html>

<script>
	// Applies to every [data-i18n] element on the page (any component can opt a text node in
	// by giving it a data-i18n="key" attribute matching an entry in src/lib/i18n.ts) — runs
	// once on load, and again whenever Header.astro's language toggle fires the
	// "droparabia:lang-changed" event, so it stays in sync no matter which page it's on.
	import { currentLang, translations } from "../lib/i18n";

	function applyTranslations() {
		const lang = currentLang();
		document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
			const entry = translations[el.dataset.i18n ?? ""];
			if (!entry) return;
			// Some tagged elements (headings with an inline colored word, etc.) have real child
			// markup, not just plain text — cache that original English HTML once, so switching
			// back to "en" restores it exactly instead of flattening it to plain text forever
			// the first time this element gets translated.
			if (el.dataset.i18nOriginal === undefined) el.dataset.i18nOriginal = el.innerHTML;
			el.innerHTML = lang === "en" ? el.dataset.i18nOriginal : entry[lang];
		});

		// Same idea for form placeholder text, which isn't part of the DOM tree the innerHTML
		// swap above touches.
		document.querySelectorAll<HTMLInputElement>("[data-i18n-placeholder]").forEach((el) => {
			const entry = translations[el.dataset.i18nPlaceholder ?? ""];
			if (entry) el.placeholder = entry[lang];
		});

		// The browser tab title isn't part of the visible DOM tree the [data-i18n] scan above
		// covers, so it's translated separately here off the same titleKey prop from Layout.astro.
		const titleEl = document.getElementById("page-title");
		const titleKey = titleEl?.dataset.titleKey;
		if (titleEl && titleKey && translations[titleKey]) {
			document.title = translations[titleKey][lang];
		}
	}

	applyTranslations();
	window.addEventListener("droparabia:lang-changed", applyTranslations);
</script>
