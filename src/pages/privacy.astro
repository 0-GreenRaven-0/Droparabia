---
// Legal copy ported verbatim from droparabia-landing's privacy-policy.astro, restyled to
// this site's Tailwind/Layout/Header/Footer instead of that page's standalone inline-CSS
// markup (which also carried GTM tags and its own nav/footer that don't apply here).
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TabAttention from "../components/TabAttention.astro";
import { translations } from "../lib/i18n";

const sections = [
	{
		key: "privacy.section1",
		heading: "1. Information We Collect",
		items: ["Personal Data (name, email address, phone number)", "Usage Data (pages visited, time spent, links clicked, funnel stage)"],
	},
	{
		key: "privacy.section2",
		heading: "2. How We Use Your Information",
		items: [
			"To process your registration and provide access to our workshop and platform",
			"To communicate with you regarding your account, follow-ups, and updates",
			"To improve our content, offers, and user experience",
			"To qualify leads and organize them based on their funnel journey",
			"For legal compliance and security purposes",
		],
	},
];
---

<Layout
	title="Privacy Policy"
	titleKey="page.privacy"
	description="Read Droparabia's Privacy Policy to learn what personal data we collect, how we use it, and how we keep it safe."
>
	<Header />

	<section class="px-6 pt-48 pb-4 lg:px-16">
		<div class="mx-auto max-w-3xl">
			<h1 data-i18n="privacy.heading" class="font-ibrand text-4xl leading-[1.1] text-neutral-900 sm:text-6xl dark:text-white">Privacy Policy</h1>
			<p data-i18n="privacy.intro" class="mt-6 border-l-2 border-primary pl-4 font-helvetica text-base text-neutral-600 sm:text-lg dark:text-neutral-400">
				Droparabia is committed to protecting your personal information. This Privacy Policy explains what data we
				collect, how we use it, and how we keep it safe when you visit droparabia.com or register for our free live
				workshop.
			</p>

			<div class="mt-10 flex flex-col gap-8">
				{
					sections.map((section) => (
						<div>
							<h2 data-i18n={`${section.key}.heading`} class="font-ibrand text-lg text-neutral-900 dark:text-white">
								{section.heading}
							</h2>
							<ul class="mt-2 flex flex-col gap-1.5">
								{section.items.map((item, i) => (
									<li
										data-i18n={`${section.key}.item${i}`}
										class="relative pl-5 font-helvetica text-sm leading-relaxed text-neutral-600 sm:text-base dark:text-neutral-400"
									>
										<span class="absolute left-0 font-bold text-primary">•</span>
										{item}
									</li>
								))}
							</ul>
						</div>
					))
				}

				<div>
					<h2 data-i18n="privacy.section3.heading" class="font-ibrand text-lg text-neutral-900 dark:text-white">3. Cookies and Tracking</h2>
					<p data-i18n="privacy.section3.paragraph" class="mt-2 font-helvetica text-sm leading-relaxed text-neutral-600 sm:text-base dark:text-neutral-400">
						We use cookies and third-party analytics tools including Google Analytics and Google Tag Manager to
						understand user behavior and improve site performance.
					</p>
				</div>

				<div>
					<h2 data-i18n="privacy.section4.heading" class="font-ibrand text-lg text-neutral-900 dark:text-white">4. Data Sharing</h2>
					<p data-i18n="privacy.section4.paragraph" class="mt-2 font-helvetica text-sm leading-relaxed text-neutral-600 sm:text-base dark:text-neutral-400">
						We do not sell or rent your personal data. We only share data with trusted third-party services (Brevo,
						Google Sheets, Calendly) when necessary to operate our platform.
					</p>
				</div>

				<div>
					<h2 data-i18n="privacy.section5.heading" class="font-ibrand text-lg text-neutral-900 dark:text-white">5. Data Security</h2>
					<p data-i18n="privacy.section5.paragraph" class="mt-2 font-helvetica text-sm leading-relaxed text-neutral-600 sm:text-base dark:text-neutral-400">
						We use encryption and secure platforms to protect your data. While no system is 100% secure, we do our
						best to safeguard your information.
					</p>
				</div>

				<div>
					<h2 data-i18n="privacy.section6.heading" class="font-ibrand text-lg text-neutral-900 dark:text-white">6. Your Rights</h2>
					<p
						data-i18n="privacy.section6.paragraph"
						class="mt-2 font-helvetica text-sm leading-relaxed text-neutral-600 sm:text-base dark:text-neutral-400"
						set:html={translations["privacy.section6.paragraph"].en}
					/>
				</div>

				<div>
					<h2 data-i18n="privacy.section7.heading" class="font-ibrand text-lg text-neutral-900 dark:text-white">7. Policy Updates</h2>
					<p data-i18n="privacy.section7.paragraph1" class="mt-2 font-helvetica text-sm leading-relaxed text-neutral-600 sm:text-base dark:text-neutral-400">
						This Privacy Policy may change from time to time. The most recent version will always be posted on this
						page.
					</p>
					<p
						data-i18n="privacy.section7.paragraph2"
						class="mt-2 font-helvetica text-sm leading-relaxed text-neutral-600 sm:text-base dark:text-neutral-400"
						set:html={translations["privacy.section7.paragraph2"].en}
					/>
				</div>
			</div>
		</div>
	</section>

	<div class="h-20" />

	<Footer />
	<TabAttention />
</Layout>
