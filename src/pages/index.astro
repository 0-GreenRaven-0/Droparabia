---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/sections/Hero.astro";
import ProductCatalog from "../components/sections/ProductCatalog.astro";
import WhyDroparabia from "../components/sections/WhyDroparabia.astro";
import SocialProof from "../components/sections/SocialProof.astro";
import Tools from "../components/sections/Tools.astro";
import TestimonialsWall from "../components/sections/TestimonialsWall.astro";
import MobileApp from "../components/sections/MobileApp.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import MajdGBT from "../components/sections/MajdGBT.astro";
import Blog from "../components/sections/Blog.astro";
import Footer from "../components/Footer.astro";

// The Droparabia app, as the MobileApp section presents it: one app, on the two stores whose
// badges that section links to. Same URLs as MobileApp.astro and Layout.astro's sameAs.
const origin = new URL(Astro.site!).origin;
const appSchema = {
	"@type": "MobileApplication",
	name: "Droparabia",
	operatingSystem: "iOS, Android",
	applicationCategory: "BusinessApplication",
	publisher: { "@id": `${origin}/#organization` },
	installUrl: [
		"https://apps.apple.com/us/app/droparabia/id6757470742",
		"https://play.google.com/store/apps/details?id=com.codergize.droparabia",
	],
};
---

<Layout schema={[appSchema]}>
	<Header />
	<Hero />
	<SocialProof />
	<HowItWorks />
	<ProductCatalog />
	<Tools />
	<MobileApp />
	<MajdGBT />
	<Blog />
	<WhyDroparabia />
	<TestimonialsWall />
	<Footer showCta={false} />
</Layout>
