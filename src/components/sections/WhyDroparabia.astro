---
// Two boxes (heading+subheading, and the bullet list) start stacked directly on top of
// each other, then pull apart HORIZONTALLY — heading to the left, bullets to the right —
// in direct 1:1 response to scroll position as the section passes through the viewport.
// The section scrolls normally (nothing is pinned/locked in place); the separation
// distance is a pure function of how far the section has scrolled through view.
const points = [
	"No huge upfront investments",
	"No spending & guessing on non selling products",
	"No owning Inventory",
	"No dealing with suppliers & shipment fees",
	"Pay for what you sell only and keep the profit",
];
---

<section id="why-droparabia" class="relative overflow-x-hidden px-6 py-12 lg:flex lg:min-h-160 lg:items-center lg:justify-center">
	<!-- Desktop/tablet: two boxes stacked directly on top of each other, pulled apart
		 horizontally in direct 1:1 response to scroll position (see the plain-JS scroll
		 handler below — no GSAP needed since it's a pure function of scroll progress). -->
	<div
		id="why-box-heading"
		class="pointer-events-none absolute z-10 hidden w-[90vw] max-w-xl flex-col items-center justify-center rounded-3xl bg-white px-10 py-12 text-center shadow-[0_2px_12px_-2px_rgba(0,0,0,0.12),0_15px_35px_-15px_rgba(0,0,0,0.2)] will-change-transform lg:flex dark:bg-neutral-900"
		style="height: 480px;"
	>
		<h2 data-i18n="why.heading" class="font-ibrand text-2xl leading-[1.15] text-neutral-900 sm:text-5xl md:text-6xl dark:text-white">
			Why Droparabia
			<span class="block text-primary">beats Traditional E-commerce &amp; Old Dropshipping</span>
		</h2>
	</div>

	<div
		id="why-box-list"
		class="pointer-events-none absolute hidden w-[90vw] max-w-xl flex-col items-center justify-center rounded-3xl bg-white px-10 py-8 shadow-[0_2px_12px_-2px_rgba(0,0,0,0.12),0_15px_35px_-15px_rgba(0,0,0,0.2)] will-change-transform lg:flex dark:bg-neutral-900"
		style="height: 480px;"
	>
		<ul class="flex h-full w-full flex-col justify-between">
			{points.map((point) => (
				<li class="rounded-full border-2 border-primary px-6 py-3 text-center">
					<span data-i18n={`why.point${points.indexOf(point)}`} class="font-helvetica text-lg font-semibold text-neutral-900 sm:text-xl dark:text-white">{point}</span>
				</li>
			))}
		</ul>
	</div>

	<!-- Mobile/tablet: a plain stacked column instead — the top card slides in from the
		 left, the bottom one from the right, both scrubbed directly to scroll position
		 (GSAP ScrollTrigger scrub, not a one-time reveal-on-appear). -->
	<div class="flex flex-col gap-8 lg:hidden">
		<div
			id="why-mobile-heading"
			class="flex flex-col items-center justify-center rounded-3xl bg-white px-8 py-10 text-center shadow-[0_2px_12px_-2px_rgba(0,0,0,0.12),0_15px_35px_-15px_rgba(0,0,0,0.2)] will-change-transform dark:bg-neutral-900"
		>
			<h2 data-i18n="why.heading" class="font-ibrand text-3xl leading-[1.15] text-neutral-900 sm:text-5xl dark:text-white">
				Why Droparabia
				<span class="block text-primary">beats Traditional E-commerce &amp; Old Dropshipping</span>
			</h2>
		</div>

		<div
			id="why-mobile-list"
			class="flex flex-col items-center justify-center rounded-3xl bg-white px-8 py-8 shadow-[0_2px_12px_-2px_rgba(0,0,0,0.12),0_15px_35px_-15px_rgba(0,0,0,0.2)] will-change-transform dark:bg-neutral-900"
		>
			<ul class="flex w-full flex-col gap-4">
				{points.map((point) => (
					<li class="rounded-full border-2 border-primary px-4 py-2 text-center">
						<span data-i18n={`why.point${points.indexOf(point)}`} class="font-helvetica text-sm font-semibold text-neutral-900 sm:text-lg dark:text-white">{point}</span>
					</li>
				))}
			</ul>
		</div>
	</div>
</section>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	gsap.registerPlugin(ScrollTrigger);

	const section = document.getElementById("why-droparabia");
	const heading = document.getElementById("why-box-heading");
	const list = document.getElementById("why-box-list");

	// Desktop/tablet only — these two boxes are `hidden` below lg, so this plain scroll
	// handler (a direct function of scroll progress, same idea as the mobile GSAP scrub
	// below) only needs to run once the matching media query actually matches.
	const desktopQuery = window.matchMedia("(min-width: 1024px)");
	if (section && heading && list) {
		let ticking = false;

		function update() {
			ticking = false;
			if (!desktopQuery.matches) return;
			const rect = section!.getBoundingClientRect();
			// 0 the instant the section's top edge touches the bottom of the viewport,
			// 1 once that edge has scrolled all the way up to the top of the viewport.
			const progress = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / window.innerHeight));

			// Far enough that the two boxes fully clear each other with a generous visible
			// gap between them — not an arbitrary large travel distance.
			const distance = heading!.offsetWidth / 2 + 24;
			heading!.style.transform = `translateX(${-progress * distance}px)`;
			list!.style.transform = `translateX(${progress * distance}px)`;
			list!.style.opacity = String(Math.min(1, progress / 0.5));
		}

		function onScroll() {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		}

		update();
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll);
	}

	// Mobile/tablet only — top card slides in from the left, bottom card from the right,
	// both scrubbed directly to each card's own scroll position (not a one-time reveal),
	// so scrolling back up un-does the slide just as smoothly. gsap.matchMedia() scopes
	// this to <lg and automatically tears the triggers down again above it.
	const mm = gsap.matchMedia();
	mm.add("(max-width: 1023.98px)", () => {
		const mobileHeading = document.getElementById("why-mobile-heading");
		const mobileList = document.getElementById("why-mobile-list");
		if (!mobileHeading || !mobileList) return;

		gsap.fromTo(
			mobileHeading,
			{ xPercent: -100, opacity: 0 },
			{
				xPercent: 0,
				opacity: 1,
				ease: "none",
				scrollTrigger: { trigger: mobileHeading, start: "top bottom", end: "top 55%", scrub: true },
			},
		);
		gsap.fromTo(
			mobileList,
			{ xPercent: 100, opacity: 0 },
			{
				xPercent: 0,
				opacity: 1,
				ease: "none",
				scrollTrigger: { trigger: mobileList, start: "top bottom", end: "top 55%", scrub: true },
			},
		);
	});
</script>
