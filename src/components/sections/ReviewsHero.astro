---
import HexBackground from "../HexBackground.astro";
import { ik } from "../../lib/imagekit";

// Same rounded-hexagon path technique used by Header.astro's nav icons and ToolPerks.astro's
// perk cards — corners trimmed back along each edge and joined with a curve. Both hexagons
// (and their text) are laid out in one SVG with exact coordinates, so the "smaller, below and
// to the right" hex only just touches the big one's corner instead of guessed percentages
// covering each other's content.
function hexPoints(w: number, h: number): [number, number][] {
	return [
		[w / 2, 0],
		[w, h * 0.25],
		[w, h * 0.75],
		[w / 2, h],
		[0, h * 0.75],
		[0, h * 0.25],
	];
}
function roundedHexPath(points: [number, number][], radius: number): string {
	const n = points.length;
	const lerp = (a: [number, number], b: [number, number], t: number): [number, number] => [
		a[0] + (b[0] - a[0]) * t,
		a[1] + (b[1] - a[1]) * t,
	];
	const approach: [number, number][] = [];
	const leave: [number, number][] = [];
	for (let i = 0; i < n; i++) {
		const curr = points[i];
		const prev = points[(i - 1 + n) % n];
		const next = points[(i + 1) % n];
		const distPrev = Math.hypot(curr[0] - prev[0], curr[1] - prev[1]);
		const distNext = Math.hypot(next[0] - curr[0], next[1] - curr[1]);
		approach.push(lerp(curr, prev, Math.min(radius / distPrev, 0.5)));
		leave.push(lerp(curr, next, Math.min(radius / distNext, 0.5)));
	}
	let d = `M ${leave[n - 1][0]} ${leave[n - 1][1]} `;
	for (let i = 0; i < n; i++) {
		d += `L ${approach[i][0]} ${approach[i][1]} Q ${points[i][0]} ${points[i][1]} ${leave[i][0]} ${leave[i][1]} `;
	}
	return d + "Z";
}

const BIG_W = 220;
const BIG_H = BIG_W * (2 / Math.sqrt(3));
const bigPath = roundedHexPath(hexPoints(BIG_W, BIG_H), BIG_W * 0.05);

const SMALL_W = 190;
const SMALL_H = SMALL_W * (2 / Math.sqrt(3));
const smallPath = roundedHexPath(hexPoints(SMALL_W, SMALL_H), SMALL_W * 0.05);

// Small hex sits below and to the right, with a visible gap from the big hex rather than
// touching corners.
const SMALL_X = BIG_W * 0.78;
const SMALL_Y = BIG_H * 0.88;

const PAD = 6;
const VB_W = SMALL_X + SMALL_W + PAD * 2;
const VB_H = SMALL_Y + SMALL_H + PAD * 2;

// Real seller reviews — just name, quote, and star rating; the revenue/scale/growth stats
// from the source screenshots are intentionally left out here.
const reviews = [
	{
		name: "Samah Salman",
		quote:
			"Great experience actually with DropArabia. The team is professional, responsive, and truly understands the market. Everything was clear, well-organized, and delivered with attention to detail.",
		rating: 5,
	},
	{
		name: "Ahmad Ladiki",
		quote: "A fantastic tool for product sourcing and fulfillment. Highly recommend for anyone serious about dropshipping.",
		rating: 5,
	},
	{ name: "Khodr", quote: "The best platform to start launching your business with low risk.", rating: 4 },
];

// Real Trustpilot reviews (screenshotted from the live TrustBox) — same card style as the
// `reviews` list above (name/quote/stars only), just with Trustpilot's own green star mark
// instead of our gradient star so it reads as an authentic excerpt.
const TRUSTPILOT_RATING = "4.3";
const trustpilotReviews = [
	{
		name: "Karim Sabeh",
		quote: "I use it personally it is beginner friendly and you can make a living from it",
		rating: 5,
	},
	{
		name: "MD Tech",
		quote:
			"DropArabia, the Ultimate Roadmap for business beginners. It's a very successful system and provides professional courses and continuous feedback and support for students. High quality products, excellent storage and packaging and smooth money transactions.",
		rating: 5,
	},
	{
		name: "Tarek",
		quote:
			"Smooth experience using this app. The platform is easy to use and order processing is simple. Definitely a useful app for anyone running a dropshipping business.",
		rating: 5,
	},
];
---

<section class="relative overflow-hidden px-6 pt-24 pb-24 lg:px-16">
	<HexBackground cutCorner={false} revealWidth={0.5} revealSide="left" />

	<div class="relative mx-auto grid max-w-6xl items-center gap-16 lg:grid-cols-2">
		<div
			class="relative mx-auto mt-3 w-full max-w-sm sm:max-w-md"
			style={{ aspectRatio: `${VB_W} / ${VB_H}`, perspective: "1200px" }}
		>
			<!-- A coin-flip (rotateY) only renders correctly across browsers on real HTML
				elements — 3D transforms on SVG <g> groups are unreliable in Safari. So each hex
				is its own self-contained SVG wrapped in an HTML div, and the divs are positioned
				with the same percentages the shared viewBox used to handle, instead of SVG
				transforms. The wrapper div is what GSAP spins. -->
			<div
				id="reviews-hex-big-spin"
				class="absolute"
				style={{
					left: "0%",
					top: "0%",
					width: `${(BIG_W / VB_W) * 100}%`,
					height: `${(BIG_H / VB_H) * 100}%`,
					// Hidden from the very first paint — the intro script sets this same opacity
					// to 0 again at runtime, but only once its module script actually executes,
					// which can trail the initial paint by a frame or more. Without this inline
					// value baked into the HTML, the hex briefly renders fully assembled/flat
					// before the coin-flip-in plays, reading as "showing the end of the animation".
					opacity: 0,
				}}
			>
				<svg viewBox={`0 0 ${BIG_W} ${BIG_H}`} class="h-full w-full">
					<defs>
						<linearGradient id="reviews-hex-big" x1="0%" y1="50%" x2="100%" y2="50%">
							<stop offset="0%" stop-color="#06a2d1" />
							<stop offset="100%" stop-color="#2745ff" />
						</linearGradient>
					</defs>
					<path d={bigPath} fill="white" class="dark:fill-neutral-900" stroke="url(#reviews-hex-big)" stroke-width="5" />
					<foreignObject id="reviews-hex-big-content" x="0" y="0" width={BIG_W} height={BIG_H}>
						<div class="flex h-full w-full flex-col items-center justify-center px-10 text-center">
							<span class="font-ibrand text-5xl text-neutral-900 sm:text-6xl dark:text-white">+700</span>
							<span data-i18n="reviews.activeSellers" class="mt-2 font-helvetica text-sm text-neutral-500 dark:text-neutral-400">Active sellers</span>
						</div>
					</foreignObject>
				</svg>
			</div>

			<div
				id="reviews-hex-small-spin"
				class="absolute"
				style={{
					left: `${(SMALL_X / VB_W) * 100}%`,
					top: `${(SMALL_Y / VB_H) * 100}%`,
					width: `${(SMALL_W / VB_W) * 100}%`,
					height: `${(SMALL_H / VB_H) * 100}%`,
					opacity: 0,
				}}
			>
				<svg viewBox={`0 0 ${SMALL_W} ${SMALL_H}`} class="h-full w-full">
					<defs>
						<linearGradient id="reviews-hex-small" x1="0%" y1="50%" x2="100%" y2="50%">
							<stop offset="0%" stop-color="#06a2d1" />
							<stop offset="100%" stop-color="#2745ff" />
						</linearGradient>
					</defs>
					<path d={smallPath} fill="white" class="dark:fill-neutral-900" stroke="url(#reviews-hex-small)" stroke-width="5" />
					<foreignObject id="reviews-hex-small-content" x="0" y="0" width={SMALL_W} height={SMALL_H}>
						<a
							href="https://www.trustpilot.com/review/droparabia.com"
							target="_blank"
							rel="noopener noreferrer"
							class="flex h-full w-full flex-col items-center justify-center gap-2 px-6 text-center"
						>
							<img src={ik("/Trustpilot-Logo.png", "w-160,q-80")} alt="Trustpilot" class="h-8 w-auto object-contain dark:hidden" />
							<img src={ik("/trustpilot-logo-white-icon.webp", "w-160,q-80")} alt="Trustpilot" class="hidden h-8 w-auto object-contain dark:block" />
							<span class="flex items-center gap-1" aria-label="4.3 out of 5 stars on Trustpilot">
								<span class="flex gap-0.5">
									{Array.from({ length: 4 }).map(() => (
										<svg width="20" height="20" viewBox="0 0 24 24">
											<path fill="#00b67a" d="M12 2l2.9 8.9H23l-7.5 5.5 2.9 8.9L12 19.8l-7.5 5.5 2.9-8.9L0 10.9h8.1z" />
										</svg>
									))}
									<svg width="20" height="20" viewBox="0 0 24 24">
										<path fill="#d4d4d4" d="M12 2l2.9 8.9H23l-7.5 5.5 2.9 8.9L12 19.8l-7.5 5.5 2.9-8.9L0 10.9h8.1z" />
									</svg>
								</span>
								<span class="font-helvetica text-sm font-bold text-neutral-700 dark:text-neutral-300">4.3</span>
							</span>
						</a>
					</foreignObject>
				</svg>
			</div>
		</div>

		<div class="flex flex-col gap-8 text-start">
			<svg width="0" height="0" class="absolute">
				<defs>
					<linearGradient id="reviews-hero-quote-star" x1="0%" y1="0%" x2="100%" y2="100%">
						<stop offset="0%" stop-color="#06a2d1" />
						<stop offset="100%" stop-color="#2745ff" />
					</linearGradient>
				</defs>
			</svg>
			{
				reviews.map((review, revIdx) => (
					<div>
						<div class="flex items-end gap-0.5" aria-label={`${review.rating} out of 5 stars`}>
							{Array.from({ length: 5 }).map((_, i) => (
								// Alternating vertical offset — a gentle zigzag echoing the offset-row
								// hex packing used elsewhere on the site, instead of a flat aligned row.
								<svg viewBox="0 0 24 24" class={`h-6 w-6 sm:h-4 sm:w-4 ${i % 2 === 0 ? "translate-y-0" : "-translate-y-1.5"}`}>
									<path
										fill={i < review.rating ? "url(#reviews-hero-quote-star)" : "#d4d4d4"}
										d="M12 2l2.9 8.9H23l-7.5 5.5 2.9 8.9L12 19.8l-7.5 5.5 2.9-8.9L0 10.9h8.1z"
									/>
								</svg>
							))}
						</div>
						<p class="mt-3 font-helvetica text-sm text-neutral-700 italic sm:text-base dark:text-neutral-300">"<span data-i18n={`reviews.review${revIdx}.quote`}>{review.quote}</span>"</p>
						<p class="mt-4 font-helvetica text-sm font-bold text-neutral-900 dark:text-white">— <span data-i18n={`reviews.review${revIdx}.name`}>{review.name}</span></p>
					</div>
				))
			}
		</div>
	</div>
</section>

<section class="relative px-6 py-16 lg:px-16">
	<div class="relative mx-auto max-w-6xl">
		<div class="flex flex-wrap items-end justify-center gap-4">
			<span data-i18n="reviews.from" class="font-ibrand text-2xl text-neutral-900 sm:text-3xl dark:text-white">From</span>
			<span class="flex items-end gap-1.5">
				<img src={ik("/Droparabia.webp", "w-100,q-80")} alt="Droparabia" class="h-10 w-auto object-contain sm:h-12" />
				<span class="brand-wordmark font-ibrand text-2xl text-neutral-900 sm:text-3xl dark:text-white">Droparabia</span>
			</span>
			<span data-i18n="reviews.sellers" class="font-ibrand text-2xl text-neutral-900 sm:text-3xl dark:text-white">Sellers</span>
		</div>

		<svg width="0" height="0" class="absolute">
			<defs>
				<linearGradient id="reviews-quote-star" x1="0%" y1="0%" x2="100%" y2="100%">
					<stop offset="0%" stop-color="#06a2d1" />
					<stop offset="100%" stop-color="#2745ff" />
				</linearGradient>
			</defs>
		</svg>

		<div class="relative mt-10">
			<div class="swiper" id="sellers-reviews-swiper">
				<div class="swiper-wrapper" id="sellers-reviews-wrapper">
					{
						reviews.map((review, revIdx) => (
							<div class="swiper-slide h-auto pb-2">
								<div class="flex h-full flex-col rounded-3xl border border-black/5 bg-white px-8 py-10 text-center shadow-[0_15px_35px_-15px_rgba(0,0,0,0.3)] dark:border-white/10 dark:bg-neutral-900 dark:shadow-[0_15px_35px_-15px_rgba(0,0,0,0.5)]">
									<div class="flex items-center justify-center gap-1.5" aria-label={`${review.rating} out of 5 stars`}>
										{Array.from({ length: 5 }).map((_, i) => (
											// A gentle wave (not a jagged zigzag) — centered on the middle star,
											// echoing the offset-row hex packing used elsewhere on the site.
											<svg
												viewBox="0 0 24 24"
												class={`h-9 w-9 sm:h-[26px] sm:w-[26px] ${["-translate-y-1", "translate-y-1.5", "-translate-y-2", "translate-y-1.5", "-translate-y-1"][i]}`}
											>
												<path
													fill={i < review.rating ? "url(#reviews-quote-star)" : "#d4d4d4"}
													d="M12 2l2.9 8.9H23l-7.5 5.5 2.9 8.9L12 19.8l-7.5 5.5 2.9-8.9L0 10.9h8.1z"
												/>
											</svg>
										))}
									</div>
									<p class="mt-5 font-helvetica text-base text-neutral-700 italic sm:text-lg dark:text-neutral-300">"<span data-i18n={`reviews.review${revIdx}.quote`}>{review.quote}</span>"</p>
									<p class="mt-5 font-helvetica text-sm font-bold text-neutral-900 dark:text-white">— <span data-i18n={`reviews.review${revIdx}.name`}>{review.name}</span></p>
								</div>
							</div>
						))
					}
				</div>
			</div>

			<button
				type="button"
				class="sellers-reviews-prev absolute top-1/2 left-0 z-10 flex h-9 w-9 -translate-x-1/2 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-[linear-gradient(135deg,#2745ff,#001eff_45%,#000c66)] text-white shadow-[0_6px_16px_-6px_rgba(0,30,255,0.35)] transition-transform duration-150 ease-out hover:scale-110 sm:h-11 sm:w-11"
				aria-label="Previous"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
					<path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
				</svg>
			</button>
			<button
				type="button"
				class="sellers-reviews-next absolute top-1/2 right-0 z-10 flex h-9 w-9 translate-x-1/2 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-[linear-gradient(135deg,#2745ff,#001eff_45%,#000c66)] text-white shadow-[0_6px_16px_-6px_rgba(0,30,255,0.35)] transition-transform duration-150 ease-out hover:scale-110 sm:h-11 sm:w-11"
				aria-label="Next"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
					<path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" />
				</svg>
			</button>
		</div>
	</div>
</section>

<section class="relative px-6 py-16 lg:px-16">
	<div class="relative mx-auto max-w-6xl">
		<div class="flex flex-wrap items-end justify-center gap-4">
			<span data-i18n="reviews.from" class="font-ibrand text-2xl text-neutral-900 sm:text-3xl dark:text-white">From</span>
			<img src={ik("/Trustpilot-Logo.png", "w-200,q-80")} alt="Trustpilot" class="h-10 w-auto object-contain sm:h-12 dark:hidden" />
			<img src={ik("/trustpilot-logo-white-icon.webp", "w-200,q-80")} alt="Trustpilot" class="hidden h-10 w-auto object-contain sm:h-12 dark:block" />
			<span class="font-ibrand text-2xl text-neutral-900 sm:text-3xl dark:text-white">{TRUSTPILOT_RATING}</span>
		</div>

		<div class="mt-10 grid gap-6 text-center md:grid-cols-3">
			{
				trustpilotReviews.map((review, tpIdx) => (
					<div class="rounded-3xl border border-black/5 bg-white px-8 py-10 shadow-[0_15px_35px_-15px_rgba(0,0,0,0.3)] dark:border-white/10 dark:bg-neutral-900 dark:shadow-[0_15px_35px_-15px_rgba(0,0,0,0.5)]">
						<div class="flex items-center justify-center gap-1" aria-label={`${review.rating} out of 5 stars on Trustpilot`}>
							{Array.from({ length: 5 }).map((_, i) => (
								<span class={`flex h-7 w-7 items-center justify-center rounded-[3px] ${i < review.rating ? "bg-[#00b67a]" : "bg-neutral-200 dark:bg-white/10"}`}>
									<svg width="16" height="16" viewBox="0 2 23 23.3">
										<path fill="white" d="M12 2l2.9 8.9H23l-7.5 5.5 2.9 8.9L12 19.8l-7.5 5.5 2.9-8.9L0 10.9h8.1z" />
									</svg>
								</span>
							))}
						</div>
						<p class="mt-5 font-helvetica text-base text-neutral-700 italic sm:text-lg dark:text-neutral-300">"<span data-i18n={`reviews.trustpilot${tpIdx}.quote`}>{review.quote}</span>"</p>
						<p class="mt-5 font-helvetica text-sm font-bold text-neutral-900 dark:text-white">— <span data-i18n={`reviews.trustpilot${tpIdx}.name`}>{review.name}</span></p>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	import gsap from "gsap";

	const container = document.querySelector<HTMLElement>("#reviews-hex-big-spin")?.parentElement;
	const bigSpin = document.getElementById("reviews-hex-big-spin");
	const smallSpin = document.getElementById("reviews-hex-small-spin");
	const bigContent = document.getElementById("reviews-hex-big-content");
	const smallContent = document.getElementById("reviews-hex-small-content");

	if (container && bigSpin && smallSpin && bigContent && smallContent) {
		// Slide in from off-screen left while coin-flipping (rotating around the vertical
		// axis) to a stop — both hexes move simultaneously. rotationY starts on an exact
		// multiple of 360 (not e.g. 900, which is equivalent to 180 — backface-on, so with
		// no backface-visibility handling it rendered as an invisible flash at the very
		// start, the "glitchy" look) so the very first frame is already front-facing.
		// A fraction of the container's width — the shape fades in via opacity now (not by
		// physically starting off-screen), so it only needs a short travel distance to read
		// as sliding in, not a full container-width trip.
		const OFFSET_X = -(container.getBoundingClientRect().width * 0.5);

		// The hex shape itself (not just its inner content) starts invisible — it was
		// previously only offset to the right, which isn't actually off-screen relative to
		// this small column, so it was visible sitting there before the animation even started.
		gsap.set([bigSpin, smallSpin], { x: OFFSET_X, rotationY: -360, opacity: 0, transformPerspective: 1400 });
		gsap.set([bigContent, smallContent], { opacity: 0 });

		gsap
			.timeline({ delay: 0.2 })
			.to([bigSpin, smallSpin], { x: 0, rotationY: 0, opacity: 1, duration: 1.3, ease: "power2.inOut" })
			.to([bigContent, smallContent], { opacity: 1, duration: 0.4, ease: "power2.out" }, "-=0.15");
	}
</script>

<script>
	import Swiper from "swiper";
	import { Navigation, Autoplay } from "swiper/modules";
	import "swiper/css";
	import { fetchReviews, type Review } from "../../lib/reviewsApi";

	const swiperEl = document.getElementById("sellers-reviews-swiper");
	const swiper =
		swiperEl &&
		new Swiper(swiperEl, {
			modules: [Navigation, Autoplay],
			slidesPerView: 1,
			spaceBetween: 24,
			breakpoints: {
				640: { slidesPerView: 2, spaceBetween: 24 },
				1024: { slidesPerView: 3, spaceBetween: 24 },
			},
			loop: true,
			autoplay: { delay: 4000, disableOnInteraction: false, pauseOnMouseEnter: true },
			navigation: {
				nextEl: ".sellers-reviews-next",
				prevEl: ".sellers-reviews-prev",
			},
		});

	// Appends real user-submitted reviews (written through the review form, approved by hand
	// in the sheet, served by the Apps Script web app — see apps-script/Code.gs) after the
	// handful of hardcoded seller quotes above, so newly written reviews actually show up
	// here instead of only ever existing in the sheet they're stored in.
	type ApiReview = Review;

	function buildSlide(review: ApiReview): HTMLDivElement {
		const slide = document.createElement("div");
		slide.className = "swiper-slide h-auto pb-2";

		const card = document.createElement("div");
		card.className =
			"flex h-full flex-col rounded-3xl border border-black/5 bg-white px-8 py-10 text-center shadow-[0_15px_35px_-15px_rgba(0,0,0,0.3)] dark:border-white/10 dark:bg-neutral-900 dark:shadow-[0_15px_35px_-15px_rgba(0,0,0,0.5)]";

		const starsRow = document.createElement("div");
		starsRow.className = "flex items-center justify-center gap-1.5";
		starsRow.setAttribute("aria-label", `${review.rating} out of 5 stars`);
		const offsets = ["-translate-y-1", "translate-y-1.5", "-translate-y-2", "translate-y-1.5", "-translate-y-1"];
		starsRow.innerHTML = Array.from({ length: 5 })
			.map((_, i) => {
				const filled = i < review.rating;
				return `<svg viewBox="0 0 24 24" class="h-9 w-9 sm:h-[26px] sm:w-[26px] ${offsets[i]}"><path fill="${
					filled ? "url(#reviews-quote-star)" : "#d4d4d4"
				}" d="M12 2l2.9 8.9H23l-7.5 5.5 2.9 8.9L12 19.8l-7.5 5.5 2.9-8.9L0 10.9h8.1z"/></svg>`;
			})
			.join(""); // safe: fixed template, no review data interpolated as markup

		const text = document.createElement("p");
		text.className = "mt-5 font-helvetica text-base text-neutral-700 italic sm:text-lg dark:text-neutral-300";
		text.textContent = `"${review.text}"`;

		const name = document.createElement("p");
		name.className = "mt-5 font-helvetica text-sm font-bold text-neutral-900 dark:text-white";
		name.textContent = `— ${review.name}`;

		card.append(starsRow, text, name);
		slide.append(card);
		return slide;
	}

	async function appendWrittenReviews() {
		const wrapper = document.getElementById("sellers-reviews-wrapper");
		if (!wrapper || !swiper) return;
		try {
			const reviews: ApiReview[] = await fetchReviews();
			if (!reviews.length) return;
			reviews.forEach((review) => wrapper.append(buildSlide(review)));
			// New slides were appended straight into the DOM (not through Swiper's own API),
			// so it needs to be told to re-scan them — loop mode also needs its cloned/duplicate
			// slides rebuilt from scratch to include the new ones.
			swiper.update();
			if (swiper.params.loop) swiper.loopDestroy(), swiper.loopCreate(), swiper.update();
		} catch {
			// No network / API unavailable — the hardcoded reviews above still render fine on
			// their own, so fail silently instead of showing an error for a bonus section.
		}
	}

	appendWrittenReviews();
</script>
