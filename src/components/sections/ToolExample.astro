---
// Used instead of ToolFeatures for tools where one annotated screenshot tells the whole
// story better than a tab list (set via tool.exampleImage in data/tools.ts).
import type { Tool } from "../../data/tools";

interface Props {
	tool: Tool;
}
const { tool } = Astro.props;
---

<section class="px-6 py-20 lg:px-16">
	<div class="mx-auto max-w-6xl">
		<img
			src={tool.exampleImage}
			alt={`${tool.label} example`}
			class="w-full object-contain drop-shadow-[0_15px_35px_-15px_rgba(0,0,0,0.28)]"
		/>
	</div>
</section>
