---
import HexBackground from "../HexBackground.astro";
import { ik } from "../../lib/imagekit";

// Real community post screenshots. `?tr=w-1400,q-85` asks ImageKit for an already-sized,
// already-compressed version rather than the full original — these render at ~400px wide
// in the grid below, so the originals were many times larger than needed.
const posts = [
	"https://ik.imagekit.io/greenraven/Droparabia%20Official%20Website/d1.png?tr=w-1400,q-85",
	"https://ik.imagekit.io/greenraven/Droparabia%20Official%20Website/d2.png?tr=w-1400,q-85",
	"https://ik.imagekit.io/greenraven/Droparabia%20Official%20Website/d3.png?tr=w-1400,q-85",
	"https://ik.imagekit.io/greenraven/Droparabia%20Official%20Website/d4.png?tr=w-1400,q-85",
	"https://ik.imagekit.io/greenraven/Droparabia%20Official%20Website/d5.png?tr=w-1400,q-85",
	"https://ik.imagekit.io/greenraven/Droparabia%20Official%20Website/d6.png?tr=w-1400,q-85",
];
---

<section id="dropvault-hero" class="relative overflow-hidden px-6 pt-16 pb-24 text-center sm:pt-20 lg:px-16 lg:pt-24">
	<HexBackground cutCorner={true} cutSide="right" />

	<!-- Logo + wordmark + subtext, pinned to the top of the section. -->
	<div class="relative z-10 mx-auto max-w-3xl">
		<div class="mx-auto flex w-fit flex-row items-center gap-3 rtl:flex-row-reverse sm:gap-4">
			<img
				id="dropvault-logo"
				src={ik("/Dropvault.png", "w-800,q-80")}
				alt="Dropvault"
				width="224"
				height="224"
				fetchpriority="high"
				decoding="async"
				class="h-24 w-24 object-contain sm:h-40 sm:w-40 lg:h-56 lg:w-56"
			/>
			<h1 id="dropvault-heading" class="brand-wordmark font-ibrand text-5xl leading-none text-neutral-900 sm:text-7xl lg:text-9xl dark:text-white">
				Dropvault
			</h1>
		</div>
		<p
			id="dropvault-subtext"
			data-i18n="dropvault.subtext"
			class="mt-2 font-helvetica text-base font-normal text-neutral-900 sm:text-lg dark:text-white"
		>
			When you get access to Droparabia, you become a member of the Dropvault community, a place where you get to grow alongside ambitious sellers and get support whenever you need it!
		</p>
	</div>

	<!-- The message field. A responsive grid handles layout and keeps cards from colliding;
		 the "random positions" come from a per-card offset applied by the script at runtime,
		 so the arrangement differs on every load instead of being baked in. -->
	<div id="dropvault-field" class="relative z-10 mx-auto mt-14 grid max-w-7xl grid-cols-1 gap-x-10 gap-y-14 sm:mt-16 sm:grid-cols-2 lg:gap-x-16 lg:gap-y-20">
		{
			posts.map((src) => (
				<img
					src={src}
					alt=""
					loading="eager"
					decoding="async"
					class="community-card w-full rounded-2xl shadow-[0_18px_40px_-20px_rgba(0,0,0,0.3)]"
				/>
			))
		}
	</div>
</section>

<style>
	/* The header intro is pure CSS on purpose. Driving it from the GSAP script meant it could
	   only begin once that module had downloaded, parsed and run — which is after the first
	   paint. On a warm cache that gap is invisible; on a cold navigation it is long enough to
	   see the hero sit blank and then jump, which is the glitch this replaces. A CSS animation
	   starts on the very first frame the element is painted, every time, with no JS involved. */
	@keyframes dropvault-intro {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	#dropvault-logo,
	#dropvault-heading,
	#dropvault-subtext {
		opacity: 0;
		animation: dropvault-intro 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	#dropvault-heading {
		animation-delay: 0.1s;
	}
	#dropvault-subtext {
		animation-delay: 0.2s;
	}

	/* Cards stay hidden until the script pops them in; see the note in the script below. */
	.community-card {
		opacity: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		#dropvault-logo,
		#dropvault-heading,
		#dropvault-subtext {
			animation: none;
			opacity: 1;
		}
		.community-card {
			opacity: 1;
		}
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	gsap.registerPlugin(ScrollTrigger);

	const cards = Array.from(document.querySelectorAll<HTMLImageElement>(".community-card"));
	const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	// The cards are remote CDN images with no intrinsic size in the markup, so until they
	// decode they occupy no space — ScrollTrigger then measures every one of them as already
	// on-screen and fires the whole set at once. So wait for them to settle, re-measure, and
	// only then play. The race() is a guard: one slow or dead image can never hold the pop-in
	// hostage for more than 2.5s.
	function imagesSettled(imgs: HTMLImageElement[], timeoutMs = 2500): Promise<unknown> {
		const waits = imgs.map((img) =>
			img.complete && img.naturalWidth > 0
				? Promise.resolve()
				: new Promise<void>((res) => {
						img.addEventListener("load", () => res(), { once: true });
						img.addEventListener("error", () => res(), { once: true });
					}),
		);
		return Promise.race([Promise.all(waits), new Promise((res) => setTimeout(res, timeoutMs))]);
	}

	if (reduced) {
		gsap.set(cards, { opacity: 1 });
	} else {
		const rand = (min: number, max: number) => min + Math.random() * (max - min);

		// Each card keeps a permanent offset so the grid reads as scattered rather than a tidy
		// gallery. No rotation — the cards stay upright. Regenerated per page load.
		//
		// Mobile is a single column, where scattering just makes the cards look misaligned —
		// and the sub-pixel transforms it produces are what was rendering the text soft. So
		// phones get no offsets at all: a plain stacked row that still fades in.
		//
		// On wider screens the offsets are capped at 45% of the grid's own gaps, read from
		// the live computed style. Two neighbours can drift toward each other, so their
		// combined travel is 2 x the cap — at 45% that's 90% of the gap, which keeps a sliver
		// between them and makes a collision impossible at any breakpoint.
		const scatter = window.innerWidth >= 640;
		const field = document.getElementById("dropvault-field");
		const gaps = field && scatter ? getComputedStyle(field) : null;
		const capX = gaps ? parseFloat(gaps.columnGap || "0") * 0.45 : 0;
		const capY = gaps ? parseFloat(gaps.rowGap || "0") * 0.45 : 0;
		// Math.round keeps every card on a whole pixel — fractional translate values blur
		// rasterized text on some devices.
		const resting = cards.map(() => ({ x: Math.round(rand(-capX, capX)), y: Math.round(rand(-capY, capY)) }));

		const playCards = () =>
			cards.forEach((card, i) => {
			const rest = resting[i];
			gsap.fromTo(
				card,
				// Starts slightly below its resting spot and small — so it reads as popping into
				// place rather than sliding in from somewhere.
				{ opacity: 0, scale: 0.82, x: rest.x, y: rest.y + 36 },
				{
					opacity: 1,
					scale: 1,
					x: rest.x,
					y: rest.y,
					duration: 0.6,
					// back.out gives the slight overshoot that makes it feel like a pop.
					ease: "back.out(1.6)",
					// Randomized delay rather than a uniform stagger, so they appear scattered in
					// time as well as in space.
					delay: rand(0, 0.5) + i * 0.09,
					scrollTrigger: { trigger: card, start: "top 88%", once: true },
				},
			);
		});

		imagesSettled(cards).then(() => {
			ScrollTrigger.refresh();
			playCards();
		});
	}
</script>
