---
import { ik } from "../../lib/imagekit";
import HexBackground from "../HexBackground.astro";
---

<!-- Two-column at lg+: copy on the left, product panel on the right bleeding off the viewport
	 edge. Below lg it collapses to the previous single centered column, with the panel dropping
	 underneath the CTAs (and no longer bleeding, so nothing gets clipped on a phone). -->
<section id="hero" class="relative overflow-hidden px-6 pt-20 pb-20 sm:pt-32 sm:pb-16 lg:pt-36 lg:pb-24">
	<HexBackground id="hex-bg-canvas" />

	<!-- relative + z-10: HexBackground's canvas is absolutely positioned, so a static
		 sibling after it still paints underneath. This lifts the content above it. -->
	<div class="relative z-10 mx-auto grid w-full max-w-[1320px] items-center gap-8 rtl:lg:[direction:ltr] lg:grid-cols-[auto_1fr] lg:gap-6">
		<!-- Mobile only: centers the headline/subheadline/CTA block within roughly the first
			 screen instead of leaving it pinned near the top under the fixed mobile header.
			 Reverts to plain top-aligned flow at sm+ (unchanged from before). -->
		<div class="flex min-h-[56svh] w-full flex-col items-center justify-center text-center sm:min-h-0 sm:justify-start lg:items-start lg:text-left rtl:lg:[direction:rtl] rtl:lg:items-start rtl:lg:text-right">
			<h1 data-i18n="hero.headline" class="font-ibrand leading-[1.15] text-neutral-900 rtl:leading-[1.7] dark:text-white">
				<span class="block text-2xl leading-[1.3] sm:text-3xl md:text-[2.5rem] rtl:leading-[1.85]">Everything you need to build a</span>
				<span class="hero-gradient-text block text-3xl leading-[1.3] sm:text-4xl md:text-[3.3rem] md:whitespace-nowrap rtl:-mt-[0.38em] rtl:leading-[1.85]">successful &amp; high-earning</span>
				<span class="block text-2xl leading-[1.3] sm:text-3xl md:text-[2.5rem] rtl:leading-[1.85]">store in one place</span>
			</h1>
			<p data-i18n="hero.subheadline" class="mt-6 max-w-[30rem] font-helvetica text-sm font-normal leading-relaxed text-neutral-900 sm:text-base sm:[-webkit-text-stroke:0.3px_currentColor] dark:text-white">
				Droparabia helps you find high-selling products from all niches and deliver them to your customer's doorstep without spending a cent on inventory, shipping or third-party services
			</p>
			<div class="mt-8 flex w-full max-w-xs flex-col items-stretch gap-4 sm:w-auto sm:max-w-none sm:flex-row sm:flex-wrap sm:items-center sm:justify-center lg:justify-start">
			<a
				href="https://calendly.com/d/cr37-8xm-k5s/drop-arabia-strategy-session"
				target="_blank"
				rel="noopener noreferrer"
				class="group inline-flex h-10 items-center justify-center gap-2 rounded-full bg-primary px-6 font-ibrand text-sm text-white shadow-[0_8px_20px_-6px_rgba(0,30,255,0.55)] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_14px_30px_-8px_rgba(0,30,255,0.7)] sm:h-12 sm:px-8 sm:text-base"
			>
				<span data-i18n="cta.getStarted">Get Started</span>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 transition-transform duration-200 ease-out group-hover:translate-x-0.5"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
			</a>
			<a
				href="https://ig.me/m/mjbusinessofficial"
				target="_blank"
				rel="noopener noreferrer"
				data-i18n="cta.talkToUs"
				class="inline-flex h-10 items-center justify-center rounded-full bg-[#e5e4e2] px-6 text-center font-ibrand text-sm text-neutral-900 shadow-[0_8px_20px_-8px_rgba(0,0,0,0.4)] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-[#dcdbd9] hover:shadow-[0_14px_30px_-10px_rgba(0,0,0,0.5)] sm:h-12 sm:px-8 sm:text-base"
			>
				Talk to Us
			</a>
			</div>
		</div>

		<!-- App screenshot, bleeding off the viewport edge at lg+. Below lg the negative margin
			 drops away so it sits fully inside its column instead of being clipped.
			 -me- (margin-inline-end), not -mr-: in RTL the grid mirrors, so the screenshot moves
			 to the left column and has to bleed off the LEFT edge. A physical -mr- kept pulling it
			 rightwards there, straight over the Arabic copy. -->
		<div class="relative lg:-mr-[40vw] lg:w-[64rem] lg:max-w-none">
			<img
				src={ik("/hero-app.webp")}
				width="1600"
				height="741"
				alt="The Droparabia dashboard's Find Products page: a searchable grid of products showing cost and delivery estimates."
				fetchpriority="high"
				decoding="async"
				class="w-full rounded-[0.7rem] shadow-[0_40px_90px_-30px_rgba(0,0,0,0.3)] sm:rounded-[0.8rem]"
			/>
		</div>
	</div>
</section>

<script>
	// Faint hexagon-tile grid rendered with Three.js, scoped to the hero section only.
	// A single InstancedMesh keeps this to one draw call. An orthographic camera (instead of
	// a perspective one) maps world units 1:1 to screen pixels, so the grid sits flat and
	// evenly across the section exactly like the plain CSS pattern it replaced — no tilt,
	// no perspective skew. Hexes are colored to match the page background so the grid reads
	// as a subtle tonal texture rather than a foreground object.
	import * as THREE from "three";

	const section = document.getElementById("hero");
	const canvas = document.getElementById("hex-bg-canvas");
	if (section && canvas instanceof HTMLCanvasElement) {
		const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

		const scene = new THREE.Scene();
		const camera = new THREE.OrthographicCamera(0, 0, 0, 0, 0.1, 100);
		camera.position.set(0, 0, 50);
		camera.lookAt(0, 0, 0);

		// Hex radius in CSS pixels — world units are mapped 1:1 to pixels via the ortho camera.
		// Smaller on narrow screens so the tiling reads at roughly the same visual density
		// as on desktop, instead of a few oversized hexes dominating a small viewport.
		const HEX_R = window.innerWidth < 640 ? 46 : window.innerWidth < 1024 ? 60 : 78;
		const GAP = 1.0; // edges nearly touching — just enough seam to read as tiled hexes
		// Same vertex-trim-and-quadratic-curve technique used for the product cluster hexes:
		// each corner is trimmed back along its two edges, then joined with a curve instead
		// of a sharp point.
		const points: [number, number][] = Array.from({ length: 6 }, (_, i) => {
			const angle = (Math.PI / 180) * (60 * i - 30);
			return [HEX_R * 0.98 * Math.cos(angle), HEX_R * 0.98 * Math.sin(angle)];
		});
		const CORNER_RADIUS = HEX_R * 0.16;
		const lerp = (a: [number, number], b: [number, number], t: number): [number, number] => [
			a[0] + (b[0] - a[0]) * t,
			a[1] + (b[1] - a[1]) * t,
		];
		const shape = new THREE.Shape();
		for (let i = 0; i < 6; i++) {
			const curr = points[i];
			const prev = points[(i - 1 + 6) % 6];
			const next = points[(i + 1) % 6];
			const distPrev = Math.hypot(curr[0] - prev[0], curr[1] - prev[1]);
			const distNext = Math.hypot(next[0] - curr[0], next[1] - curr[1]);
			const approach = lerp(curr, prev, Math.min(CORNER_RADIUS / distPrev, 0.5));
			const leave = lerp(curr, next, Math.min(CORNER_RADIUS / distNext, 0.5));
			if (i === 0) shape.moveTo(approach[0], approach[1]);
			else shape.lineTo(approach[0], approach[1]);
			shape.quadraticCurveTo(curr[0], curr[1], leave[0], leave[1]);
		}
		shape.closePath();
		const geometry = new THREE.ShapeGeometry(shape);

		// A diagonal two-stop gradient (from the provided swatch: #E7E7E7 at 41%, #CDCDCD
		// at 60%, flat before/after) baked into each hex's own vertex colors — every hex
		// gets the identical gradient across its own face, not one gradient spread across
		// the whole grid.
		const GRADIENT_STOPS: [number, string][] = [
			[0.41, "#d0d0d0"],
			[0.6, "#c0c0c0"],
		];
		function hexToRGB(hex: string): [number, number, number] {
			const n = parseInt(hex.slice(1), 16);
			return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
		}
		function gradientColor(t: number): [number, number, number] {
			const clamped = Math.min(1, Math.max(0, t));
			const [t0, c0] = GRADIENT_STOPS[0];
			const [t1, c1] = GRADIENT_STOPS[1];
			if (clamped <= t0) return hexToRGB(c0);
			if (clamped >= t1) return hexToRGB(c1);
			const localT = (clamped - t0) / (t1 - t0);
			const [r0, g0, b0] = hexToRGB(c0);
			const [r1, g1, b1] = hexToRGB(c1);
			return [r0 + (r1 - r0) * localT, g0 + (g1 - g0) * localT, b0 + (b1 - b0) * localT];
		}
		geometry.computeBoundingBox();
		const hexBBox = geometry.boundingBox!;
		const hexBBoxW = hexBBox.max.x - hexBBox.min.x;
		const hexBBoxH = hexBBox.max.y - hexBBox.min.y;
		const posAttr = geometry.attributes.position;
		const colorArray = new Float32Array(posAttr.count * 3);
		for (let v = 0; v < posAttr.count; v++) {
			// Same top-left -> bottom-right diagonal as the swatch, normalized over this
			// hex's own bounding box.
			const nx = (posAttr.getX(v) - hexBBox.min.x) / hexBBoxW;
			const nyFromTop = (hexBBox.max.y - posAttr.getY(v)) / hexBBoxH;
			const [r, g, b] = gradientColor((nx + nyFromTop) / 2);
			colorArray[v * 3] = r;
			colorArray[v * 3 + 1] = g;
			colorArray[v * 3 + 2] = b;
		}
		geometry.setAttribute("color", new THREE.BufferAttribute(colorArray, 3));

		// The baked gradient is already the light-mode tone — material.color is just a
		// tint multiplier on top of it, white (no-op) in light mode, dark in dark mode.
		const HEX_COLOR_DARK = 0x262626;
		const material = new THREE.MeshBasicMaterial({ vertexColors: true, color: 0xffffff });

		function render() {
			renderer.render(scene, camera);
		}

		// Sync to whatever theme is already active before the first render — see the same
		// fix (and full explanation) in HexBackground.astro's identical setup. Not calling
		// render() here since nothing's been added to the scene yet.
		material.color.set(document.documentElement.classList.contains("dark") ? HEX_COLOR_DARK : 0xffffff);

		// See HexBackground.astro's identical setup for why this listens for a dedicated
		// event (dispatched once per actual theme flip by Header.astro) instead of a raw
		// class MutationObserver, and renders synchronously rather than deferring a frame.
		window.addEventListener("droparabia:theme-changed", (e) => {
			const theme = (e as CustomEvent<{ theme: string }>).detail.theme;
			material.color.set(theme === "dark" ? HEX_COLOR_DARK : 0xffffff);
			render();
		});

		// Grid sized to this section's own footprint (plus headroom for modest resizes)
		// instead of a single one-size-fits-all constant that always paid for enough
		// instances to cover a 4200x2000 world regardless of how tall the Hero actually is.
		const rect0 = section.getBoundingClientRect();
		const GRID_W = Math.max(rect0.width, window.innerWidth) * 1.3;
		const GRID_H = rect0.height * 1.3;
		const COLS = Math.ceil(GRID_W / (HEX_R * Math.sqrt(3) * GAP)) + 2;
		const ROWS = Math.ceil(GRID_H / (HEX_R * 1.5 * GAP)) + 2;
		const count = COLS * ROWS;
		const mesh = new THREE.InstancedMesh(geometry, material, count);
		const dummy = new THREE.Object3D();

		// A straight diagonal cut taking a corner off the bottom-left of the grid, like the
		// old CSS version had — one clean line, not a blob of holes or a ragged edge.
		const cornerX = -rect0.width / 2;
		const cornerY = -rect0.height / 2;
		const cutDistance = Math.max(rect0.width, rect0.height) * 0.42;
		const cutAngle = Math.PI / 4; // 45deg diagonal
		const cutNormalX = Math.cos(cutAngle);
		const cutNormalY = Math.sin(cutAngle);
		// Also drop the row that would otherwise sit half-cut across the very bottom edge
		// of the section — a full hex radius of clearance so nothing there gets clipped.
		const bottomEdge = cornerY + HEX_R * 1.05;

		let i = 0;
		for (let r = 0; r < ROWS; r++) {
			for (let c = 0; c < COLS; c++) {
				const x = (HEX_R * Math.sqrt(3) * (c + (r % 2) / 2) - (COLS * HEX_R * Math.sqrt(3)) / 2) * GAP;
				const y = (HEX_R * 1.5 * r - (ROWS * HEX_R * 1.5) / 2) * GAP;

				const missing =
					(x - cornerX) * cutNormalX + (y - cornerY) * cutNormalY < cutDistance || y < bottomEdge;

				dummy.position.set(x, y, 0);
				dummy.rotation.set(0, 0, 0);
				dummy.scale.setScalar(missing ? 0 : 1);
				dummy.updateMatrix();
				mesh.setMatrixAt(i, dummy.matrix);
				i++;
			}
		}
		mesh.instanceMatrix.needsUpdate = true;
		scene.add(mesh);

		function resize() {
			const rect = section!.getBoundingClientRect();
			renderer.setSize(rect.width, rect.height, false);
			camera.left = -rect.width / 2;
			camera.right = rect.width / 2;
			camera.top = rect.height / 2;
			camera.bottom = -rect.height / 2;
			camera.updateProjectionMatrix();
			render();
		}
		resize();
		window.addEventListener("resize", resize);
	}
</script>
