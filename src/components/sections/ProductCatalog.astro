import HexBackground from "../HexBackground.astro";
import { ik } from "../../lib/imagekit";
import { translations } from "../../lib/i18n";

// Niches the toggle next to the hex cluster cycles through — each folder under
// /public/products holds 8 numbered images, one per hex. The toggle is a diagonal
// line (bottom-left to top-right) with an arrow button at each end.
const niches = ["Kitchen", "Health and beauty", "Electronic", "Home & Garden"];

// Both sides of the comparison, per product. The Alibaba side is deliberately the full
// breakdown rather than one number — the whole argument the section makes is that the real
// cost of sourcing yourself is the MOQ-multiplied total, not the per-item price.
// Each row is a label and a value, where the value keeps the working shown rather than just
// the result — "$15 x 0.109 = $1.63" instead of "$1.63". Seeing the MOQ multiply out is the
// argument the section is making, so the arithmetic is the content, not a detail.
interface Row {
	label: string;
	value: string;
	// Emphasised rows: the three derived totals on the Alibaba side, and the profit line.
	strong?: boolean;
}
// summary is what the card shows at rest — the few numbers that make the comparison. detail
// is the working behind them, revealed by the info button, so the formulas are available to
// anyone who wants to check the maths without crowding the card for everyone who doesn't.
interface Side {
	summary: Row[];
	detail: Row[];
	// The listing these figures were read off, shown as a link at the foot of the popover.
	// Optional: only products whose source is public have one.
	sourceUrl?: string;
}
interface Pricing {
	name: string;
	alibaba: Side;
	droparabia: Side;
}

// What the Droparabia price covers. The same for every product, so it's written once rather
// than copied per product where the four copies could drift apart.
const DROPARABIA_DETAIL: Row[] = [
	{ label: "MOQ", value: "No minimum order quantity, you pay the cost of each item sold and keep the profit" },
	{ label: "Price covers", value: "Sourcing, international shipping, warehousing, fulfillment and handling" },
	{ label: "Shipping", value: "Air freight to Lebanon averages around $15/kg, and varies by shipment" },
	{ label: "Operations", value: "Around 15–20% covers fulfillment, warehousing and related running costs" },
];

