// Products whose figures and photo have both been supplied, keyed by niche. Photos go through
// ik() like every other image on the site, so they are served CDN-side at the size actually
// rendered rather than as full-size files from this origin. w+h together crop to a square,
// which matters because three of the source photos are not square and would otherwise sit
// letterboxed inside the frame.
const sourced: Record<string, { img: string; pricing: Pricing }[]> = {
	Kitchen: [
		{ img: ik("/electric-milk-frother.jpg", "w-420,h-420,q-80"), pricing: MILK_FROTHER },
