<!-- The niche product catalog: a toggle that spins a 2x2 grid through one niche's four
	 products at a time, each card pairing the product with what it costs to source and what it
	 can sell for. Lived inside the hero until it was pulled out into its own section so the
	 hero could carry a single visual instead of two competing ones. -->
<section id="product-catalog" class="relative flex flex-col items-center px-6 py-20 text-center sm:py-24 lg:py-28">
	<!-- Same left-half hex wash ReviewsHero uses: the grid fills from the left edge and stops
		 at the middle of the section, so the cluster on the right sits against clean background. -->
	<HexBackground cutCorner={false} revealWidth={0.5} revealSide="left" fadeTop={true} fadeHeight={1} />

	<!-- z-10 keeps the copy above the absolutely-positioned canvas above; the toggle and
		 cluster below already carry their own `relative`. -->
