	],
	// Key must match the niche string exactly, hence "Health and beauty" rather than "Beauty".
	"Health and beauty": [
		{ img: ik("/eyebrow-trimmer.jpg", "w-420,h-420,q-80"), pricing: EYEBROW_TRIMMER },
		{ img: ik("/hair-oil-applicator.jpg", "w-420,h-420,q-80"), pricing: HAIR_OIL_APPLICATOR },
