		{ img: ik("/spaceship-humidifier.webp", "w-420,h-420,q-80"), pricing: SPACESHIP_HUMIDIFIER },
	],
	"Home & Garden": [
		{ img: ik("/solar-floor-lamp.png", "w-420,h-420,q-80"), pricing: SOLAR_FLOOR_LAMP },
		{ img: ik("/flame-diffuser.webp", "w-420,h-420,q-80"), pricing: FLAME_DIFFUSER },
		{ img: ik("/lint-remover.jpg", "w-420,h-420,q-80"), pricing: LINT_REMOVER },
		{ img: ik("/shoe-cleaner.jpg", "w-420,h-420,q-80"), pricing: SHOE_CLEANER },
	],
};

const nicheProducts = niches.map((niche) =>
	Array.from({ length: 4 }, (_, i) => sourced[niche]?.[i]?.img ?? ik(`/products/${niche}/${i + 1}.png`, "w-300,q-80")),
);
// Row text is rewritten per product by the client script, so these rows can't use the
// global [data-i18n] applier — it caches the first English value it sees as the "original"
// and would restore that one for every later product. Each row instead carries the i18n key
// for its label (and, where the value is prose rather than a figure, for its value), and the
// catalog's own script resolves them. Figures are identical in every language and are left
// exactly as written; only the unit word after a MOQ count is substituted.
const ROW_KEYS: Record<string, string> = {
	"Cost per item": "catalog.row.costPerItem",
	MOQ: "catalog.row.moq",
	"Shipping per item": "catalog.row.shippingPerItem",
	"Total cost": "catalog.row.totalCost",
	"Product Cost": "catalog.row.productCost",
	"Estimated Selling": "catalog.row.estimatedSelling",
	"Estimated Profit": "catalog.row.estimatedProfit",
	Weight: "catalog.row.weight",
	"Shipping cost per item": "catalog.row.shippingCostPerItem",
	// Distinguished from "Product Cost" above only by case — the summary row and the
	// working's line are different strings and translate differently.
	"Product cost": "catalog.row.productCostCalc",
	"Shipping cost": "catalog.row.shippingCost",
	"Price covers": "catalog.row.priceCovers",
	Shipping: "catalog.row.shipping",
	Operations: "catalog.row.operations",
};
// Product names go through the same per-row mechanism as the price rows: the niche switch
// rewrites them, so the global applier would restore the wrong one in English.
const NAME_KEYS: Record<string, string> = {
	"Electric milk frother": "catalog.product.milkFrother",
	"2 in 1 Portable Blender & Cup": "catalog.product.blender",
	"Multifunction Crepe Maker": "catalog.product.crepeMaker",
	"Mini Electric Garlic Machine": "catalog.product.garlicMachine",
	"2 in 1 eyebrow trimmer": "catalog.product.eyebrowTrimmer",
	"2 in 1 Electric Hair Oil Applicator and Scalp Massager": "catalog.product.hairOilApplicator",
	"Cordless Automatic Hair Curler": "catalog.product.hairCurler",
	"Neck and face wrinkle remover": "catalog.product.wrinkleRemover",
	"Gun Massager": "catalog.product.gunMassager",
	"Astronaut Galaxy Sky Projector Rechargeable with Bluetooth Speaker": "catalog.product.galaxyProjector",
	"RGB Raining Humidifier Rain Cloud": "catalog.product.rainCloud",
	"Astronaut Spaceship Aromatherapy Air Humidifier Purifier": "catalog.product.spaceshipHumidifier",
	"Outdoor Waterproof LED Floor Lamp Solar": "catalog.product.solarLamp",
	"Flame Diffuser Night Light Gift Set Decor Fire Flame Humidifier": "catalog.product.flameDiffuser",
	"Lint Remover": "catalog.product.lintRemover",
	"Shoe cleaner": "catalog.product.shoeCleaner",
};
const VALUE_KEYS: Record<string, string> = {
	None: "catalog.value.none",
	"150ml/bottle (≈ 0.150 Kg)": "catalog.value.shoeWeight",
	"No minimum order quantity, you pay the cost of each item sold and keep the profit": "catalog.value.noMoq",
	"Sourcing, international shipping, warehousing, fulfillment and handling": "catalog.value.covers",
	"Air freight to Lebanon averages around $15/kg, and varies by shipment": "catalog.value.airFreight",
	"Around 15–20% covers fulfillment, warehousing and related running costs": "catalog.value.operations",
};

interface I18nRow extends Row {
	lkey?: string;
	vkey?: string;
	// Set for "100 piece"-style values: the count stays, the unit word is translated.
	count?: string;
}
function enrichRow(row: Row): I18nRow {
	const out: I18nRow = { ...row };
	if (ROW_KEYS[row.label]) out.lkey = ROW_KEYS[row.label];
	const moq = /^(\d[\d,]*) piece$/.exec(row.value);
	if (VALUE_KEYS[row.value]) out.vkey = VALUE_KEYS[row.value];
	else if (moq) {
		out.vkey = "catalog.value.piece";
		out.count = moq[1];
	}
	return out;
}
function enrichSide(side: Side) {
	return { ...side, summary: side.summary.map(enrichRow), detail: side.detail.map(enrichRow) };
}

// Only the catalog's own strings are handed to the client script — the whole translation
// table would be a few dozen KiB of inline JSON on every page load.
const catalogI18n = Object.fromEntries(Object.entries(translations).filter(([k]) => k.startsWith("catalog.")));

// Parallel to nicheProducts: same niche order, same product order.
const nichePricing = niches.map((niche) =>
	Array.from({ length: 4 }, (_, i) => {
		const pricing = sourced[niche]?.[i]?.pricing ?? PLACEHOLDER;
		return {
			name: pricing.name,
			nameKey: NAME_KEYS[pricing.name],
			alibaba: enrichSide(pricing.alibaba),
			droparabia: enrichSide(pricing.droparabia),
		};
	}),
);
// Display labels only — folder names above (used for image paths) stay in English regardless
// of language, since they're just disk paths, not user-facing text.
const nicheLabels = niches.map((_, i) => translations[`hero.niche${i}`]);

// Blends a hex color toward white (t > 0) or black (t < 0) to build a highlight/shadow
// pair for a glossy sheen, instead of one flat stroke color per hexagon.
function shade(hex: string, t: number): string {
	const n = parseInt(hex.slice(1), 16);
	const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
	const mix = (c: number) => Math.round(c + ((t > 0 ? 255 : 0) - c) * Math.abs(t));
	return `rgb(${mix(r)}, ${mix(g)}, ${mix(b)})`;
}

// One accent per card. The hexagons are gone, but their outline gradient isn't — it now
// frames the product photo itself, still walking the same primary-to-secondary ramp down
// the grid so the four cards read as one set.
const cardAccents = ["#2745ff", "#1c35d3", "#1124a8", "#000c66"].map((color) => ({
	color,
	light: shade(color, 0.55),
	dark: shade(color, -0.35),
}));
// The outline is painted as a gradient background with the image inset by BORDER_PX, since
// a border can't take a gradient. Angle matches the stroke the hexes used.
const BORDER_PX = 4;
const frameGradient = (a: { light: string; color: string; dark: string }) =>
	`linear-gradient(135deg, ${a.light} 0%, ${a.color} 35%, ${a.dark} 65%, ${a.light} 100%)`;

