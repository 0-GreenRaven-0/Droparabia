---
// Shared hero for every /tools/[slug] page. Left: a big bold headline, description
// paragraph, and CTAs — all left-aligned. Right: a large product screenshot (no
// per-tool app screenshots exist yet, so every tool reuses the same generic one already
// used by the homepage Tools section). A HexBackground decorates the section instead of
// the reference's diagonal-stripe image.
import type { Tool } from "../../data/tools";
import HexBackground from "../HexBackground.astro";
import { ik } from "../../lib/imagekit";

interface Props {
	tool: Tool;
}
const { tool } = Astro.props;
---

<section class="relative overflow-hidden px-6 pt-28 pb-24 sm:pt-48 lg:pr-16 lg:pl-3">
	<HexBackground cutCorner={false} />

	<div class="relative grid max-w-6xl items-center gap-14 lg:grid-cols-2">
		<div class="text-center lg:text-start">
			<svg width="56" height="56" viewBox="0 0 24 24" class="mx-auto mb-4 sm:hidden">
				<g fill="none" stroke={tool.color} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={tool.icon} />
			</svg>
			<h1 data-i18n={`tool.${tool.slug}.tagline`} class="font-ibrand text-3xl leading-[1.1] text-neutral-900 sm:text-5xl lg:text-6xl dark:text-white">
				{tool.tagline}
			</h1>
			<p data-i18n={`tool.${tool.slug}.paragraph`} class="mt-6 max-w-lg font-helvetica text-sm text-neutral-600 sm:text-lg dark:text-neutral-400">
				{tool.description.paragraph}
			</p>
			<div class="mt-8 flex w-full max-w-xs flex-col items-stretch gap-4 sm:w-auto sm:max-w-none sm:flex-row sm:flex-wrap sm:items-center sm:justify-center lg:justify-start">
				<a
					href="https://calendly.com/d/cr37-8xm-k5s/drop-arabia-strategy-session"
					target="_blank"
					rel="noopener noreferrer"
					class="group inline-flex items-center justify-center gap-2 h-11 rounded-full border-[3px] border-primary bg-white pr-1 pl-5 font-ibrand text-sm text-neutral-900 transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_10px_25px_-8px_rgba(0,30,255,0.35)] sm:h-14 sm:gap-3 sm:pr-1.5 sm:pl-8 sm:text-base dark:bg-neutral-900 dark:text-white"
				>
					<span data-i18n="cta.getStarted">Get Started</span>
					<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-white transition-transform duration-200 ease-out group-hover:translate-x-0.5 sm:h-9 sm:w-9">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5 12h14" />
							<path d="m12 5 7 7-7 7" />
						</svg>
					</span>
				</a>
				<a
					href="/tools"
					data-i18n="cta.talkToUs"
					class="inline-flex h-11 items-center justify-center rounded-full border-[3px] border-neutral-900 bg-white px-5 text-center font-ibrand text-sm text-neutral-900 transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-black/5 sm:h-14 sm:px-11 sm:text-base dark:border-white dark:bg-neutral-900 dark:text-white dark:hover:bg-white/10"
				>
					Talk to Us
				</a>
			</div>
		</div>

		<div class="-mr-6 w-[145%] sm:mr-0 sm:w-full lg:w-[260%]">
			<img
				src={tool.heroImage ?? ik("/Tools/Winning Products.png", "w-1200,q-80")}
				alt={tool.label}
				class="w-full object-contain drop-shadow-[0_15px_35px_-15px_rgba(0,0,0,0.28)]"
			/>
		</div>
	</div>
</section>
