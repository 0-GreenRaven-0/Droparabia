---
// Branding-only hero: unlike the shared ToolHero (side-by-side, image bleeding off-screen),
// this is a vertical stack — heading, subheading, CTAs, then the branding example image
// sitting underneath, full width. Branding has no feature-tabs section; the example image
// here does that job instead.
import type { Tool } from "../../data/tools";
import HexBackground from "../HexBackground.astro";
import { ik } from "../../lib/imagekit";

interface Props {
	tool: Tool;
}
const { tool } = Astro.props;
---

<section class="relative overflow-hidden px-6 pt-48 pb-24 text-center lg:px-16">
	<HexBackground cutCorner={false} />

	<div class="relative mx-auto max-w-3xl">
		<h1 data-i18n={`tool.${tool.slug}.tagline`} class="font-ibrand text-4xl leading-[1.1] text-neutral-900 sm:text-5xl lg:text-6xl dark:text-white">
			{tool.tagline}
		</h1>
		<p data-i18n={`tool.${tool.slug}.paragraph`} class="mt-6 font-helvetica text-base text-neutral-600 sm:text-lg dark:text-neutral-400">
			{tool.description.paragraph}
		</p>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
			<a
				href="https://calendly.com/d/cr37-8xm-k5s/drop-arabia-strategy-session"
				target="_blank"
				rel="noopener noreferrer"
				class="group inline-flex h-10 items-center justify-center gap-2 rounded-full bg-primary px-6 font-ibrand text-sm text-white shadow-[0_8px_20px_-6px_rgba(0,30,255,0.55)] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_14px_30px_-8px_rgba(0,30,255,0.7)] sm:h-12 sm:px-8 sm:text-base"
			>
				<span data-i18n="cta.getStarted">Get Started</span>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 transition-transform duration-200 ease-out group-hover:translate-x-0.5"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
			</a>
			<a
				href="/tools"
				data-i18n="cta.backToTools"
				class="inline-flex h-10 items-center justify-center rounded-full bg-[#e5e4e2] px-6 text-center font-ibrand text-sm text-neutral-900 shadow-[0_8px_20px_-8px_rgba(0,0,0,0.4)] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-[#dcdbd9] hover:shadow-[0_14px_30px_-10px_rgba(0,0,0,0.5)] sm:h-12 sm:px-8 sm:text-base"
			>
				Back to Tools
			</a>
		</div>
	</div>

	<div class="relative mx-auto mt-16 max-w-5xl">
		<img
			src={tool.heroImage ?? ik("/Tools/Winning Products.png", "w-1200,q-80")}
			alt={tool.label}
			class="w-full rounded-2xl object-contain drop-shadow-[0_15px_35px_-15px_rgba(0,30,255,0.22)]"
		/>
	</div>
</section>
