---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
	title: string;
	description: string;
	/** Human-readable published date shown on the page, e.g. "January 30, 2026". */
	date: string;
	/** ISO 8601 published date, e.g. "2026-01-30". Feeds <time> and Article schema. */
	datePublished: string;
	/**
	 * ISO 8601 date this post was last substantively revised. Bump it whenever you update
	 * the post — cited pages skew heavily towards recently-updated ones, and the effect comes
	 * from updating an existing URL rather than publishing a new one. Defaults to the
	 * published date so an un-revised post is never falsely marked fresh.
	 */
	dateModified?: string;
	readTime: string;
	// i18n keys for the header text. Optional so a page without translations still renders.
	titleKey?: string;
	dateKey?: string;
	readTimeKey?: string;
	// Either pass a photo URL here, or provide a `banner` slot (e.g. a branded white card) —
	// the slot takes priority when both would otherwise apply.
	image?: string;
	toc: { id: string; label: string }[];
}
const { title, description, date, datePublished, dateModified, readTime, image, toc, titleKey, dateKey, readTimeKey } =
	Astro.props;
const hasBannerSlot = Astro.slots.has("banner");
const modified = dateModified ?? datePublished;
const updated = modified !== datePublished;

const articleSchema = {
	"@type": "Article",
	headline: title,
	description,
	datePublished,
	dateModified: modified,
	author: { "@type": "Person", name: "Majd Abdulsalam" },
	publisher: { "@id": "https://droparabia.com/#organization" },
	mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
	inLanguage: "en",
};
---

<Layout title={title} description={description} schema={[articleSchema]}>
	<Header />

	<article class="px-6 pt-40 pb-4 lg:px-16">
		<div class="mx-auto max-w-6xl">
			<h1 data-i18n={titleKey} class="font-ibrand text-4xl leading-[1.1] text-neutral-900 sm:text-6xl dark:text-white">{title}</h1>

			<div class="mt-4 flex flex-wrap items-center gap-2 font-helvetica text-sm text-neutral-500 dark:text-neutral-400">
				<time datetime={datePublished} data-i18n={dateKey}>{date}</time>
				<span>&bull;</span>
				<span data-i18n={readTimeKey}>{readTime}</span>
				{updated && (
					<>
						<span>&bull;</span>
						<span>
							Updated{" "}
							<time datetime={modified}>
								{new Date(modified).toLocaleDateString("en-US", {
									year: "numeric",
									month: "long",
									day: "numeric",
									timeZone: "UTC",
								})}
							</time>
						</span>
					</>
				)}
			</div>

			{
				hasBannerSlot ? (
					<div class="mt-8 aspect-video w-full overflow-hidden rounded-3xl">
						<slot name="banner" />
					</div>
				) : (
					<img src={image} alt="" class="mt-8 aspect-video w-full rounded-3xl object-cover" />
				)
			}

			<div class="mt-12 grid gap-12 lg:grid-cols-[1fr_260px]">
				<div data-article-content class="min-w-0 max-w-2xl">
					<slot />
				</div>

				<!-- Desktop only. The active-section color swap and the reading-progress fill both
					 come from the script below — the fill uses `transform: scaleY()` (not height)
					 so the scroll listener driving it stays compositor-only and never forces layout. -->
				<aside class="hidden lg:block">
					<div class="sticky top-32">
						<p class="font-helvetica text-xs font-semibold tracking-wide text-neutral-400 uppercase">Page Contents</p>
						<nav class="relative mt-4 flex flex-col">
							<div class="absolute inset-y-0 left-0 w-px bg-neutral-200 dark:bg-neutral-800"></div>
							<div id="toc-progress" class="absolute inset-y-0 left-0 w-px origin-top scale-y-0 bg-primary"></div>
							{toc.map((item) => (
								<a
									href={`#${item.id}`}
									data-toc-link={item.id}
									class="border-l-2 border-transparent py-1.5 pl-4 font-helvetica text-sm text-neutral-500 transition-colors hover:text-neutral-900 dark:hover:text-white"
								>
									{item.label}
								</a>
							))}
						</nav>
					</div>
				</aside>
			</div>
		</div>
	</article>

	<div class="h-20" />

	<Footer />
</Layout>

<script>
	// Highlights whichever section heading is currently at the top of the viewport in the
	// "Page Contents" sidebar — cheap since it's driven by IntersectionObserver (fires only on
	// actual crossings) rather than a scroll listener recalculating on every frame.
	const links = new Map(
		Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")).map((el) => [el.dataset.tocLink, el]),
	);
	const headings = Array.from(links.keys())
		.map((id) => document.getElementById(id!))
		.filter((el): el is HTMLElement => el !== null);

	function setActive(id: string) {
		links.forEach((el, key) => {
			const active = key === id;
			el.classList.toggle("border-primary", active);
			el.classList.toggle("text-primary", active);
			el.classList.toggle("font-semibold", active);
			el.classList.toggle("border-transparent", !active);
			el.classList.toggle("text-neutral-500", !active);
		});
	}

	if (headings.length) {
		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries.filter((e) => e.isIntersecting);
				if (visible.length) setActive(visible[0].target.id);
			},
			{ rootMargin: "-120px 0px -70% 0px" },
		);
		headings.forEach((h) => observer.observe(h));
	}

	// Reading-progress fill running down the same line the TOC items sit against — 0 at the
	// top of the article, full by the time its last line scrolls past the viewport. Driven by
	// a scroll listener (IntersectionObserver only fires on crossings, not continuously) but
	// rAF-throttled and touching only `transform`, so it stays compositor-only and never
	// forces a layout recalc on scroll.
	const progressBar = document.getElementById("toc-progress");
	const articleContent = document.querySelector<HTMLElement>("[data-article-content]");
	if (progressBar && articleContent) {
		let ticking = false;
		function updateProgress() {
			const rect = articleContent!.getBoundingClientRect();
			const total = rect.height - window.innerHeight;
			const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
			progressBar!.style.transform = `scaleY(${progress})`;
			ticking = false;
		}
		window.addEventListener(
			"scroll",
			() => {
				if (!ticking) {
					requestAnimationFrame(updateProgress);
					ticking = true;
				}
			},
			{ passive: true },
		);
		updateProgress();
	}
</script>
