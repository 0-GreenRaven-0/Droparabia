<div
	id="nav-overlay"
	class="fixed inset-0 z-40 bg-black/50 opacity-0 pointer-events-none backdrop-blur-[2px] transition-opacity duration-200 ease-out will-change-opacity"
	aria-hidden="true"
></div>

<script>
	const themeToggle = document.getElementById("theme-toggle");
	const themeToggleMobile = document.getElementById("theme-toggle-mobile");
	const root = document.documentElement;

	const applyTheme = (theme: string) => {
		root.classList.toggle("dark", theme === "dark");
		localStorage.setItem("theme", theme);
	};

	let themeTransitionTimer: ReturnType<typeof setTimeout> | undefined;
	function toggleTheme() {
		// Force every element's color-related properties onto the exact same transition for
		// this one moment, so the whole page switches together instead of each element
		// following whatever transition (if any) its own component happened to declare.
		clearTimeout(themeTransitionTimer);
		root.classList.add("theme-transition-active");
		themeTransitionTimer = setTimeout(() => root.classList.remove("theme-transition-active"), 320);

		const next = root.classList.contains("dark") ? "light" : "dark";
		applyTheme(next);
	}
	themeToggle?.addEventListener("click", toggleTheme);
	themeToggleMobile?.addEventListener("click", toggleTheme);

	// Hover-open nav menus share one window: switching between Tools/Resources while it's
	// open slides the old content out and the new content in, instead of opening a second window.
	const overlay = document.getElementById("nav-overlay");
	const navMenu = document.getElementById("nav-menu");
	const menuOrder = ["tools", "resources"];
	const menuPanels: Record<string, HTMLElement | null> = {
		tools: document.getElementById("tools-panel"),
		resources: document.getElementById("resources-panel"),
	};
	let activeMenu: string | null = null;
	let closeTimer: ReturnType<typeof setTimeout> | undefined;

	function sizeMenuTo(name: string) {
		const panel = menuPanels[name];
		if (!navMenu || !panel) return;
		navMenu.style.width = `${panel.scrollWidth}px`;
		navMenu.style.height = `${panel.scrollHeight}px`;
	}

	function slidePanelsTo(name: string) {
		const targetIdx = menuOrder.indexOf(name);
		menuOrder.forEach((key, i) => {
			const panel = menuPanels[key];
			if (!panel) return;
			if (key === name) {
				panel.style.transform = "translateX(0%) scale(1)";
				panel.style.opacity = "1";
				panel.style.filter = "blur(0px)";
				panel.style.pointerEvents = "auto";
			} else {
				// A slight inward scale + blur on top of the slide (instead of a flat translateX
				// crossfade) so the outgoing/incoming panel reads as settling into place rather
				// than just sliding past — same easing/duration as the container's own
				// width/height resize below, so nothing visually lags behind.
				panel.style.transform = `translateX(${i < targetIdx ? "-100%" : "100%"}) scale(0.94)`;
				panel.style.opacity = "0";
				panel.style.filter = "blur(4px)";
				panel.style.pointerEvents = "none";
			}
		});
	}

	function openMenu(name: string) {
		clearTimeout(closeTimer);
		const wasOpen = navMenu?.classList.contains("opacity-100");

		if (!wasOpen) {
			// Size + position the panels instantly (no transition) before revealing, so the
			// opening fade/scale never fights a width/height animation.
			const prevTransition = navMenu?.style.transitionProperty;
			if (navMenu) navMenu.style.transitionProperty = "none";
			slidePanelsTo(name);
			sizeMenuTo(name);
			void navMenu?.offsetWidth;
			if (navMenu) navMenu.style.transitionProperty = prevTransition ?? "";
			navMenu?.classList.remove("invisible", "opacity-0", "scale-75");
			navMenu?.classList.add("opacity-100", "scale-100");
		} else if (activeMenu !== name) {
			slidePanelsTo(name);
			sizeMenuTo(name);
		}

		activeMenu = name;
		overlay?.classList.remove("opacity-0", "pointer-events-none");
		overlay?.classList.add("opacity-100");
	}

	function closeMenu() {
		closeTimer = setTimeout(() => {
			navMenu?.classList.add("invisible", "opacity-0", "scale-75");
			navMenu?.classList.remove("opacity-100", "scale-100");
			overlay?.classList.add("opacity-0", "pointer-events-none");
			overlay?.classList.remove("opacity-100");
			activeMenu = null;
		}, 120);
	}

	menuOrder.forEach((name) => {
		const item = document.querySelector(`[data-nav-item="${name}"]`);
		item?.addEventListener("mouseenter", () => openMenu(name));
		item?.addEventListener("mouseleave", closeMenu);
	});
	navMenu?.addEventListener("mouseenter", () => {
		if (activeMenu) openMenu(activeMenu);
	});
	navMenu?.addEventListener("mouseleave", closeMenu);

	// Same toggle+dropdown wiring for both the desktop pill's language button and the
	// mobile header bar's copy — kept as one setup function instead of duplicating it.
	function setLang(lang: string) {
		localStorage.setItem("lang", lang);
		document.documentElement.lang = lang;
		document.documentElement.dir = lang === "ar" ? "rtl" : "ltr";
		// Layout.astro's applyTranslations() listens for this to re-run on every [data-i18n]
		// element on the page, whichever page that happens to be.
		window.dispatchEvent(new Event("droparabia:lang-changed"));
	}
	function openLangMenu(menu: HTMLElement) {
		menu.classList.remove("invisible", "opacity-0", "scale-90");
		menu.classList.add("opacity-100", "scale-100");
	}
	function closeLangMenu(menu: HTMLElement) {
		menu.classList.add("invisible", "opacity-0", "scale-90");
		menu.classList.remove("opacity-100", "scale-100");
	}
	function setupLangToggle(toggleId: string, menuId: string) {
		const toggle = document.getElementById(toggleId);
		const menu = document.getElementById(menuId);
		if (!toggle || !menu) return;
		toggle.addEventListener("click", (e) => {
			e.stopPropagation();
			const isOpen = menu.classList.contains("opacity-100");
			if (isOpen) closeLangMenu(menu);
			else openLangMenu(menu);
			toggle.setAttribute("aria-expanded", String(!isOpen));
		});
		menu.querySelectorAll("[data-lang]").forEach((btn) => {
			btn.addEventListener("click", () => {
				setLang(btn.getAttribute("data-lang") ?? "en");
				closeLangMenu(menu);
				toggle.setAttribute("aria-expanded", "false");
			});
		});
		document.addEventListener("click", () => {
			closeLangMenu(menu);
			toggle.setAttribute("aria-expanded", "false");
		});
	}
	setupLangToggle("lang-toggle", "lang-menu");
	setupLangToggle("lang-toggle-mobile", "lang-menu-mobile");

	const mobileMenuToggle = document.getElementById("mobile-menu-toggle");
	const mobileMenu = document.getElementById("mobile-menu");
	const iconMenuOpen = document.getElementById("icon-menu-open");
	const iconMenuClose = document.getElementById("icon-menu-close");

	function setMobileMenu(open: boolean) {
		// No dark backdrop here — the menu itself is a full-screen opaque panel, not a small
		// dropdown, so the shared #nav-overlay (used by the desktop hover dropdown) would just
		// paint a dimming layer on top of it since both sit at the same z-index. Kept in the DOM
		// at all times (never `hidden`) so the opacity/transform toggle below actually animates.
		if (open) {
			mobileMenu?.classList.remove("invisible", "opacity-0", "-translate-y-4");
			mobileMenu?.classList.add("opacity-100", "translate-y-0");
		} else {
			mobileMenu?.classList.add("invisible", "opacity-0", "-translate-y-4");
			mobileMenu?.classList.remove("opacity-100", "translate-y-0");
			setAllAccordions(false);
		}
		iconMenuOpen?.classList.toggle("hidden", open);
		iconMenuClose?.classList.toggle("hidden", !open);
		mobileMenuToggle?.setAttribute("aria-expanded", String(open));
		document.body.classList.toggle("overflow-hidden", open);
	}

	mobileMenuToggle?.addEventListener("click", () => {
		setMobileMenu(mobileMenu?.classList.contains("invisible") ?? true);
	});

	// Tools/Resources open as accordions inside the full-screen menu (not a separate grid) —
	// height is animated via a CSS grid-template-rows 0fr/1fr trick so it doesn't need JS to
	// measure content height, and the chevron rotates to match.
	const accordionToggles = document.querySelectorAll<HTMLButtonElement>(".mobile-accordion-toggle");
	function setAccordion(toggle: HTMLButtonElement, open: boolean) {
		const panel = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
		const chevron = toggle.querySelector(".accordion-chevron");
		if (panel) panel.style.gridTemplateRows = open ? "1fr" : "0fr";
		chevron?.classList.toggle("rotate-180", open);
		toggle.setAttribute("aria-expanded", String(open));
	}
	function setAllAccordions(open: boolean) {
		accordionToggles.forEach((toggle) => setAccordion(toggle, open));
	}
	accordionToggles.forEach((toggle) => {
		toggle.addEventListener("click", () => {
			setAccordion(toggle, toggle.getAttribute("aria-expanded") !== "true");
		});
	});

	overlay?.addEventListener("click", () => {
		if (activeMenu) closeMenu();
	});

	// A resize past the lg breakpoint (e.g. rotating a tablet to landscape) reveals the
	// desktop nav again — the mobile menu would otherwise stay open underneath it.
	const lgQuery = window.matchMedia("(min-width: 1024px)");
	lgQuery.addEventListener("change", (e) => {
		if (e.matches) setMobileMenu(false);
	});

	mobileMenu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => setMobileMenu(false));
	});
</script>
