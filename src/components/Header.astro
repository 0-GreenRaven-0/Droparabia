---
import { ik } from "../lib/imagekit";

const navLinks = [
	{ label: "Tools", href: "/tools" },
	{ label: "Resources", href: "/resources" },
	{ label: "Reviews", href: "/reviews" },
	{ label: "Contact", href: "/contact" },
];

// Resources dropdown — rendered with the exact same hexagon-outline style as the Tools menu.
// Icons are Lucide's raw path data (npm: "lucide"), inlined here since these render as
// plain SVG strings via set:html rather than as components.
const resources = [
	{
		label: "FAQ",
		description: "Answers to the questions we get most",
		href: "/faq",
		key: "faq",
		// CircleQuestionMark
		icon: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
	},
	{
		label: "Broadcast channel",
		description: "Announcements and drops, straight to you",
		href: "https://www.instagram.com/channel/Aba2ifyff8O_0xvs/",
		key: "broadcast",
		// Radio
		icon: '<path d="M16.247 7.761a6 6 0 0 1 0 8.478"/><path d="M19.075 4.933a10 10 0 0 1 0 14.134"/><path d="M4.925 19.067a10 10 0 0 1 0-14.134"/><path d="M7.753 16.239a6 6 0 0 1 0-8.478"/><circle cx="12" cy="12" r="2"/>',
	},
	{
		label: "Contact",
		description: "Reach the Droparabia support team",
		href: "/contact",
		key: "contact",
		// Mail
		icon: '<path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/>',
	},
	{
		label: "About Us",
		description: "Who we are and why we started Droparabia",
		href: "/about",
		key: "about",
		// UsersRound
		icon: '<path d="M18 21a8 8 0 0 0-16 0"/><circle cx="10" cy="8" r="5"/><path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3"/>',
	},
];

// Each tool renders inside the same rounded, shiny-gradient hexagon outline used for the
// product cluster in the Hero — white inner fill, blue icon centered inside.
// Icons are Lucide's raw path data (npm: "lucide"), inlined here since these render as
// plain SVG strings via set:html rather than as components.
const tools = [
	{
		label: "Find Products",
		description: "Search a huge catalog of winning products",
		href: "/tools/find-products",
		slug: "find-products",
		// Search
		icon: '<path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/>',
	},
	{
		label: "AI Winning Products",
		description: "Let AI surface today's best-selling picks",
		href: "/tools/ai-winning-products",
		slug: "ai-winning-products",
		// Sparkles
		icon: '<path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><circle cx="4" cy="20" r="2"/>',
	},
	{
		label: "AI Studio",
		description: "Generate product creatives in seconds",
		href: "/tools/ai-studio",
		slug: "ai-studio",
		// WandSparkles
		icon: '<path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"/><path d="m14 7 3 3"/><path d="M5 6v4"/><path d="M19 14v4"/><path d="M10 2v2"/><path d="M7 8H3"/><path d="M21 16h-4"/><path d="M11 3H9"/>',
	},
	{
		label: "Branding",
		description: "Build a store identity buyers trust",
		href: "/tools/branding",
		slug: "branding",
		// Tag
		icon: '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>',
	},
	{
		label: "Product Request",
		description: "Ask us to source anything you need",
		href: "/tools/product-request",
		slug: "product-request",
		// PackagePlus
		icon: '<path d="M12 22V12"/><path d="M16 17h6"/><path d="M19 14v6"/><path d="M21 10.535V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.729l7 4a2 2 0 0 0 2 .001l1.675-.955"/><path d="M3.29 7 12 12l8.71-5"/><path d="m7.5 4.27 8.997 5.148"/>',
	},
	{
		label: "Leader Board",
		description: "See how you rank against top sellers",
		href: "/tools/leader-board",
		slug: "leader-board",
		// Trophy
		icon: '<path d="M10 14.66v1.626a2 2 0 0 1-.976 1.696A5 5 0 0 0 7 21.978"/><path d="M14 14.66v1.626a2 2 0 0 0 .976 1.696A5 5 0 0 1 17 21.978"/><path d="M18 9h1.5a1 1 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z"/><path d="M6 9H4.5a1 1 0 0 1 0-5H6"/>',
	},
];

// Same 8-shade blue gradient used for the product hexagons in the Hero, so the icon
// outlines stay part of the same visual family.
const TOOL_HEX_COLORS = ["#2745ff", "#213de9", "#1c35d3", "#162dbd", "#1124a8", "#0b1c92", "#06147c", "#000c66"];
function shade(hex: string, t: number): string {
	const n = parseInt(hex.slice(1), 16);
	const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
	const mix = (c: number) => Math.round(c + ((t > 0 ? 255 : 0) - c) * Math.abs(t));
	return `rgb(${mix(r)}, ${mix(g)}, ${mix(b)})`;
}

// Same rounded-hexagon path builder as the Hero's product cluster (pointy-top, corners
// trimmed back along each edge and joined with a curve).
const TOOL_HEX_W = 40;
const TOOL_HEX_SIZE = TOOL_HEX_W / Math.sqrt(3);
const TOOL_HEX_H = TOOL_HEX_SIZE * 2;
const TOOL_HEX_PAD = 3;
const TOOL_SVG_W = TOOL_HEX_W + TOOL_HEX_PAD * 2;
const TOOL_SVG_H = TOOL_HEX_H + TOOL_HEX_PAD * 2;
// Every item is a fixed width in both rows — the honeycomb stagger comes from a fixed
// margin on row two, not from squeezing that row's items into less space (which is what
// broke the spacing before: unequal item widths per row = unequal icon-to-icon gaps).
const TOOL_ITEM_W = 240;
const TOOL_ITEM_GAP = 24;
const TOOL_ROW_OFFSET = (TOOL_ITEM_W + TOOL_ITEM_GAP) / 2;
// Tools still has 6 items split 3-and-3 in an interlocking honeycomb (Resources has since
// dropped to 4 items and moved to its own plain 2-and-2 split, see RES_PANEL_W below).
const TOOL_PANEL_W = TOOL_ROW_OFFSET + TOOL_ITEM_W * 3 + TOOL_ITEM_GAP * 2 + 56; // + panel padding
// Icons are authored on a 24x24 grid; scale the whole group down and re-center it inside
// the smaller hex instead of hand-editing each icon's coordinates.
const TOOL_ICON_SCALE = 0.7;
const TOOL_ICON_X = TOOL_HEX_W / 2 - 12 * TOOL_ICON_SCALE;
const TOOL_ICON_Y = TOOL_HEX_H / 2 - 12 * TOOL_ICON_SCALE;
const toolHexPoints: [number, number][] = [
	[TOOL_HEX_W / 2, 0],
	[TOOL_HEX_W, TOOL_HEX_H * 0.25],
	[TOOL_HEX_W, TOOL_HEX_H * 0.75],
	[TOOL_HEX_W / 2, TOOL_HEX_H],
	[0, TOOL_HEX_H * 0.75],
	[0, TOOL_HEX_H * 0.25],
];
function roundedHexPath(points: [number, number][], radius: number): string {
	const n = points.length;
	const lerp = (a: [number, number], b: [number, number], t: number): [number, number] => [
		a[0] + (b[0] - a[0]) * t,
		a[1] + (b[1] - a[1]) * t,
	];
	const approach: [number, number][] = [];
	const leave: [number, number][] = [];
	for (let i = 0; i < n; i++) {
		const curr = points[i];
		const prev = points[(i - 1 + n) % n];
		const next = points[(i + 1) % n];
		const distPrev = Math.hypot(curr[0] - prev[0], curr[1] - prev[1]);
		const distNext = Math.hypot(next[0] - curr[0], next[1] - curr[1]);
		approach.push(lerp(curr, prev, Math.min(radius / distPrev, 0.5)));
		leave.push(lerp(curr, next, Math.min(radius / distNext, 0.5)));
	}
	let d = `M ${leave[n - 1][0]} ${leave[n - 1][1]} `;
	for (let i = 0; i < n; i++) {
		d += `L ${approach[i][0]} ${approach[i][1]} Q ${points[i][0]} ${points[i][1]} ${leave[i][0]} ${leave[i][1]} `;
	}
	return d + "Z";
}
const toolHexPath = roundedHexPath(toolHexPoints, 8);

// Gradient ids are built from each item's label/href — sanitized so labels with spaces
// ("Broadcast channel", "About Us") don't break the `url(#id)` reference (a raw space
// inside url(#...) is invalid, silently dropping the stroke and leaving that hex outline
// blank).
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");

// Tools and Resources both have 6 items now — same 3-per-row honeycomb split, same stagger
// offset on the bottom row, so the two panels line up exactly.
const toolTopRow = tools.slice(0, 3).map((t, i) => ({ ...t, color: TOOL_HEX_COLORS[i] }));
const toolBottomRow = tools.slice(3, 6).map((t, i) => ({ ...t, color: TOOL_HEX_COLORS[i + 3] }));
const TOOL_BOTTOM_OFFSET = TOOL_ROW_OFFSET;

// Resources dropped to 4 items (down from 6) — same honeycomb idea as Tools, just a 2-and-2
// split instead of 3-and-3. Both rows have exactly 2 items each, so the half-item stagger
// offset on the bottom row is symmetric (unlike the old 3-and-1 split, which left a single
// item stranded on its own half-offset row).
const resTopRow = resources.slice(0, 2).map((r, i) => ({ ...r, color: TOOL_HEX_COLORS[i] }));
const resBottomRow = resources.slice(2, 4).map((r, i) => ({ ...r, color: TOOL_HEX_COLORS[i + 2] }));
const RES_BOTTOM_OFFSET = TOOL_ROW_OFFSET;
const RES_PANEL_W = TOOL_ROW_OFFSET + TOOL_ITEM_W * 2 + TOOL_ITEM_GAP + 56;
---

<!-- Desktop nav — the floating pill, lg+ only. Mobile/tablet get a separate plain
	 rectangle bar + full-screen menu below instead (see #mobile-header / #mobile-menu). -->
<header class="fixed inset-x-0 top-6 z-50 hidden justify-center px-4 lg:flex">
	<nav
		class="relative flex w-full max-w-5xl items-center justify-between gap-2 rounded-full border border-black/5 bg-white/70 py-3 pl-5 pr-3 shadow-[0_4px_16px_-4px_rgba(0,0,0,0.15)] backdrop-blur-xl dark:border-white/10 dark:bg-neutral-900/70 dark:shadow-[0_4px_16px_-4px_rgba(0,0,0,0.4)]"
	>
		<!-- Logo -->
		<a href="/" class="flex shrink-0 items-center gap-2.5 pl-2">
			<img src={ik("/Droparabia.webp", "w-100,q-80")} alt="Droparabia" class="h-9 w-9" />
			<span class="font-ibrand text-xl leading-none text-neutral-900 dark:text-white">Droparabia</span>
		</a>

		<!-- Nav links -->
		<ul class="flex items-center gap-1 font-helvetica text-[15px] text-neutral-900 dark:text-white">
			{navLinks.map((link) =>
				link.label === "Tools" || link.label === "Resources" ? (
					<li class="relative" data-nav-item={link.label === "Tools" ? "tools" : "resources"}>
						<span class="inline-flex cursor-pointer items-center gap-1.5 rounded-full px-4 py-2.5 transition-all duration-150 ease-out hover:translate-y-px hover:bg-black/[0.07] hover:shadow-[inset_0_2px_5px_rgba(0,0,0,0.2),inset_0_1px_2px_rgba(0,0,0,0.15)] dark:hover:bg-black/25 dark:hover:shadow-[inset_0_2px_5px_rgba(0,0,0,0.5),inset_0_1px_2px_rgba(0,0,0,0.35)]">
							<span data-i18n={`nav.${link.label.toLowerCase()}`}>{link.label}</span>
							<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-900 dark:text-white">
								<polyline points="6 9 12 15 18 9" />
							</svg>
						</span>
					</li>
				) : (
					<li class="relative">
						<a
							href={link.href}
							data-i18n={`nav.${link.label.toLowerCase()}`}
							class="inline-block cursor-pointer rounded-full px-4 py-2.5 transition-all duration-150 ease-out hover:translate-y-px hover:bg-black/[0.07] hover:shadow-[inset_0_2px_5px_rgba(0,0,0,0.2),inset_0_1px_2px_rgba(0,0,0,0.15)] dark:hover:bg-black/25 dark:hover:shadow-[inset_0_2px_5px_rgba(0,0,0,0.5),inset_0_1px_2px_rgba(0,0,0,0.35)]"
						>
							{link.label}
						</a>
					</li>
				)
			)}
		</ul>

		<!-- Shared nav dropdown window: Tools/Resources content lives inside as sliding panels so
			 hovering between the two triggers a horizontal slide instead of opening a second window. -->
		<div
			id="nav-menu"
			class="invisible absolute left-1/2 top-full mt-3 origin-top -translate-x-1/2 scale-75 overflow-hidden opacity-0 transition-[opacity,scale,visibility,width,height] duration-400 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-transform"
		>
			<div class="relative">
				<div
					id="resources-panel"
					class="absolute left-0 top-0 transition-[transform,opacity,filter] duration-400 ease-[cubic-bezier(0.16,1,0.3,1)]"
					style={{ width: `${RES_PANEL_W}px`, maxWidth: "92vw" }}
				>
					<div class="rounded-3xl border border-black/5 bg-white/90 p-7 pb-5 shadow-[0_14px_35px_-12px_rgba(0,30,255,0.18)] backdrop-blur-xl dark:border-white/10 dark:bg-neutral-900/90">
						<div class="flex" style={{ gap: `${TOOL_ITEM_GAP}px` }}>
							{resTopRow.map((item) => (
								<a
								href={item.href}
								target={item.href.startsWith("http") ? "_blank" : undefined}
								rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
								class="group -mx-2 -my-2 flex shrink-0 cursor-pointer items-center gap-3 rounded-2xl px-2 py-2 transition-all duration-150 ease-out hover:translate-y-px hover:bg-black/[0.07] hover:shadow-[inset_0_2px_5px_rgba(0,0,0,0.2),inset_0_1px_2px_rgba(0,0,0,0.15)] dark:hover:bg-black/25 dark:hover:shadow-[inset_0_2px_5px_rgba(0,0,0,0.5),inset_0_1px_2px_rgba(0,0,0,0.35)]"
								style={{ width: `${TOOL_ITEM_W}px` }}
							>
									<svg
										class="shrink-0"
										width={TOOL_SVG_W}
										height={TOOL_SVG_H}
										viewBox={`-${TOOL_HEX_PAD} -${TOOL_HEX_PAD} ${TOOL_SVG_W} ${TOOL_SVG_H}`}
									>
										<defs>
											<linearGradient id={`res-hex-${slug(item.label)}`} x1="15%" y1="0%" x2="85%" y2="100%">
												<stop offset="0%" stop-color={shade(item.color, 0.55)} />
												<stop offset="35%" stop-color={item.color} />
												<stop offset="65%" stop-color={shade(item.color, -0.35)} />
												<stop offset="100%" stop-color={shade(item.color, 0.55)} />
											</linearGradient>
										</defs>
										<path d={toolHexPath} fill="white" class="dark:fill-neutral-900" stroke={`url(#res-hex-${slug(item.label)})`} stroke-width="2.5" />
										<g
											transform={`translate(${TOOL_ICON_X}, ${TOOL_ICON_Y}) scale(${TOOL_ICON_SCALE})`}
											style={{ color: item.color }}
											fill="none"
											stroke={item.color}
											stroke-width={1.8 / TOOL_ICON_SCALE}
											stroke-linecap="round"
											stroke-linejoin="round"
											set:html={item.icon}
										/>
									</svg>
									<span class="flex min-w-0 flex-col">
										<span data-i18n={`resources.${item.key}.label`} class="font-helvetica text-sm font-semibold text-neutral-900 dark:text-white">{item.label}</span>
										<span data-i18n={`resources.${item.key}.desc`} class="font-helvetica text-xs leading-snug text-neutral-500 dark:text-neutral-400">{item.description}</span>
									</span>
								</a>
							))}
						</div>
						<div class="mt-6 flex" style={{ gap: `${TOOL_ITEM_GAP}px`, marginLeft: `${RES_BOTTOM_OFFSET}px` }}>
							{resBottomRow.map((item) => (
								<a
								href={item.href}
								target={item.href.startsWith("http") ? "_blank" : undefined}
								rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
								class="group -mx-2 -my-2 flex shrink-0 cursor-pointer items-center gap-3 rounded-2xl px-2 py-2 transition-all duration-150 ease-out hover:translate-y-px hover:bg-black/[0.07] hover:shadow-[inset_0_2px_5px_rgba(0,0,0,0.2),inset_0_1px_2px_rgba(0,0,0,0.15)] dark:hover:bg-black/25 dark:hover:shadow-[inset_0_2px_5px_rgba(0,0,0,0.5),inset_0_1px_2px_rgba(0,0,0,0.35)]"
								style={{ width: `${TOOL_ITEM_W}px` }}
							>
									<svg
										class="shrink-0"
										width={TOOL_SVG_W}
										height={TOOL_SVG_H}
										viewBox={`-${TOOL_HEX_PAD} -${TOOL_HEX_PAD} ${TOOL_SVG_W} ${TOOL_SVG_H}`}
									>
										<defs>
											<linearGradient id={`res-hex-${slug(item.label)}`} x1="15%" y1="0%" x2="85%" y2="100%">
												<stop offset="0%" stop-color={shade(item.color, 0.55)} />
												<stop offset="35%" stop-color={item.color} />
												<stop offset="65%" stop-color={shade(item.color, -0.35)} />
												<stop offset="100%" stop-color={shade(item.color, 0.55)} />
											</linearGradient>
										</defs>
										<path d={toolHexPath} fill="white" class="dark:fill-neutral-900" stroke={`url(#res-hex-${slug(item.label)})`} stroke-width="2.5" />
										<g
											transform={`translate(${TOOL_ICON_X}, ${TOOL_ICON_Y}) scale(${TOOL_ICON_SCALE})`}
											style={{ color: item.color }}
											fill="none"
											stroke={item.color}
											stroke-width={1.8 / TOOL_ICON_SCALE}
											stroke-linecap="round"
											stroke-linejoin="round"
											set:html={item.icon}
										/>
									</svg>
									<span class="flex min-w-0 flex-col">
										<span data-i18n={`resources.${item.key}.label`} class="font-helvetica text-sm font-semibold text-neutral-900 dark:text-white">{item.label}</span>
										<span data-i18n={`resources.${item.key}.desc`} class="font-helvetica text-xs leading-snug text-neutral-500 dark:text-neutral-400">{item.description}</span>
									</span>
								</a>
							))}
						</div>
					</div>
				</div>

				<div
					id="tools-panel"
					class="absolute left-0 top-0 transition-[transform,opacity,filter] duration-400 ease-[cubic-bezier(0.16,1,0.3,1)]"
					style={{ width: `${TOOL_PANEL_W}px`, maxWidth: "92vw" }}
				>
					<div class="rounded-3xl border border-black/5 bg-white/90 p-7 pb-5 shadow-[0_14px_35px_-12px_rgba(0,30,255,0.18)] backdrop-blur-xl dark:border-white/10 dark:bg-neutral-900/90">
						<div class="flex" style={{ gap: `${TOOL_ITEM_GAP}px` }}>
							{toolTopRow.map((tool) => (
								<a href={tool.href} class="group -mx-2 -my-2 flex shrink-0 cursor-pointer items-center gap-3 rounded-2xl px-2 py-2 transition-all duration-150 ease-out hover:translate-y-px hover:bg-black/[0.07] hover:shadow-[inset_0_2px_5px_rgba(0,0,0,0.2),inset_0_1px_2px_rgba(0,0,0,0.15)] dark:hover:bg-black/25 dark:hover:shadow-[inset_0_2px_5px_rgba(0,0,0,0.5),inset_0_1px_2px_rgba(0,0,0,0.35)]" style={{ width: `${TOOL_ITEM_W}px` }}>
									<svg
										class="shrink-0"
										width={TOOL_SVG_W}
										height={TOOL_SVG_H}
										viewBox={`-${TOOL_HEX_PAD} -${TOOL_HEX_PAD} ${TOOL_SVG_W} ${TOOL_SVG_H}`}
									>
										<defs>
											<linearGradient id={`tool-hex-${tool.href}`} x1="15%" y1="0%" x2="85%" y2="100%">
												<stop offset="0%" stop-color={shade(tool.color, 0.55)} />
												<stop offset="35%" stop-color={tool.color} />
												<stop offset="65%" stop-color={shade(tool.color, -0.35)} />
												<stop offset="100%" stop-color={shade(tool.color, 0.55)} />
											</linearGradient>
										</defs>
										<path d={toolHexPath} fill="white" class="dark:fill-neutral-900" stroke={`url(#tool-hex-${tool.href})`} stroke-width="2.5" />
										<g
											transform={`translate(${TOOL_ICON_X}, ${TOOL_ICON_Y}) scale(${TOOL_ICON_SCALE})`}
											style={{ color: tool.color }}
											fill="none"
											stroke={tool.color}
											stroke-width={1.8 / TOOL_ICON_SCALE}
											stroke-linecap="round"
											stroke-linejoin="round"
											set:html={tool.icon}
										/>
									</svg>
									<span class="flex min-w-0 flex-col">
										<span data-i18n={`tool.${tool.slug}.label`} class="font-helvetica text-sm font-semibold text-neutral-900 dark:text-white">{tool.label}</span>
