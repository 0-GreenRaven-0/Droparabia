<script>
	import { translations } from "../lib/i18n";

	const originalTitle = document.title;
	function awayTitle(): string {
		const lang = localStorage.getItem("lang") === "ar" ? "ar" : "en";
		return translations["tabAttention.away"][lang];
	}
	let timer: ReturnType<typeof setTimeout> | undefined;

	// A synthesized attention-grabbing alert (Web Audio) instead of an external sound
	// file — no licensing to worry about, nothing to download, works offline.
	let audioCtx: AudioContext | null = null;

	// Browsers only allow an AudioContext to start/resume during a real user gesture
	// (click/key/touch) — the alert itself fires later from a setTimeout, which doesn't
	// count as one. Without this, anyone who tabs away before clicking anything on the
	// page gets a permanently suspended context and the alert silently never plays.
	// Unlocking it on the first genuine interaction guarantees it's ready in time.
	function unlockAudio() {
		audioCtx ??= new AudioContext();
		if (audioCtx.state === "suspended") audioCtx.resume();
	}
	["pointerdown", "keydown", "touchstart"].forEach((event) => {
		window.addEventListener(event, unlockAudio, { once: true });
	});

	function playAlert() {
		audioCtx ??= new AudioContext();
		if (audioCtx.state === "suspended") audioCtx.resume();
		const ctx = audioCtx;

		// Three quick rising square-wave beeps — sharper and more "notification-like"
		// than a soft sine whoosh, so it actually cuts through when the tab isn't focused.
		const notes = [660, 880, 1046.5];
		notes.forEach((freq, i) => {
			const start = ctx.currentTime + i * 0.14;
			const osc = ctx.createOscillator();
			const gain = ctx.createGain();
			osc.type = "square";
			osc.frequency.setValueAtTime(freq, start);
			gain.gain.setValueAtTime(0.0001, start);
			gain.gain.exponentialRampToValueAtTime(0.18, start + 0.02);
			gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.12);
			osc.connect(gain).connect(ctx.destination);
			osc.start(start);
			osc.stop(start + 0.13);
		});
	}

	document.addEventListener("visibilitychange", () => {
		if (document.hidden) {
			timer = setTimeout(() => {
				document.title = awayTitle();
				playAlert();
			}, 5000);
		} else {
			clearTimeout(timer);
			document.title = originalTitle;
		}
	});
</script>
