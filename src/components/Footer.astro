---
import HexBackground from "./HexBackground.astro";
import { ik } from "../lib/imagekit";

// Mirrors the link sets defined in Header.astro (kept as a separate, lighter copy here —
// label/href only, no icons/hex styling needed for a plain footer list).
const toolLinks = [
	{ label: "Find Products", href: "/tools/find-products", key: "tool.find-products.label" },
	{ label: "AI Winning Products", href: "/tools/ai-winning-products", key: "tool.ai-winning-products.label" },
	{ label: "AI Studio", href: "/tools/ai-studio", key: "tool.ai-studio.label" },
	{ label: "Branding", href: "/tools/branding", key: "tool.branding.label" },
	{ label: "Product Request", href: "/tools/product-request", key: "tool.product-request.label" },
	{ label: "Leader Board", href: "/tools/leader-board", key: "tool.leader-board.label" },
];
const resourceLinks = [
	{ label: "FAQ", href: "/faq", key: "resources.faq.label" },
	{ label: "Broadcast channel", href: "/broadcast", key: "resources.broadcast.label" },
	{ label: "Contact", href: "/contact", key: "resources.contact.label" },
	{ label: "About Us", href: "/about", key: "resources.about.label" },
];
const companyLinks = [
	{ label: "Reviews", href: "/reviews", key: "nav.reviews" },
	{ label: "Contact", href: "/contact", key: "nav.contact" },
	{ label: "Dropvault Community", href: "/dropvault", key: "nav.dropvault" },
];
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden px-6 pt-16 pb-8 lg:px-16">
	<HexBackground cutCorner={false} fadeTop={true} />

	<div class="relative z-10 mx-auto max-w-6xl">
		<a href="/" class="mx-auto flex w-fit items-center gap-4 sm:gap-8">
			<img src={ik("/Droparabia.webp", "w-400,q-80")} alt="Droparabia" class="h-20 w-20 shrink-0 sm:h-32 sm:w-32 lg:h-44 lg:w-44" />
			<h2 data-i18n="footer.cta.heading" class="font-ibrand text-2xl leading-[1.1] text-neutral-900 sm:text-5xl lg:text-6xl dark:text-white">
				<span>Kickstart your <span class="whitespace-nowrap">high-earning</span></span>{" "}
				online store today!
			</h2>
		</a>

		<!-- Final CTA buttons (heading now lives up in the logo lockup above; the tools hex
			 chain that used to sit here was removed). -->
		<div class="mt-6 flex flex-col items-center gap-3 sm:mt-8">
			<div class="flex w-full max-w-xs flex-col items-stretch gap-3 sm:w-auto sm:max-w-none sm:flex-row sm:flex-wrap sm:items-center sm:justify-center sm:gap-4">
				<a
					href="/tools"
					class="group inline-flex items-center justify-center gap-2 rounded-full border-[3px] border-primary bg-white py-1 pr-1 pl-5 font-ibrand text-xs text-neutral-900 transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_10px_25px_-8px_rgba(0,30,255,0.35)] sm:gap-3 sm:py-1.5 sm:pr-1.5 sm:pl-8 sm:text-sm dark:bg-neutral-900 dark:text-white"
				>
					<span data-i18n="cta.getStarted">Get Started</span>
					<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-white transition-transform duration-200 ease-out group-hover:translate-x-0.5 sm:h-9 sm:w-9">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5 12h14" />
							<path d="m12 5 7 7-7 7" />
						</svg>
					</span>
				</a>
				<a
					href="https://calendly.com/d/cr37-8xm-k5s/drop-arabia-strategy-session"
					target="_blank"
					rel="noopener noreferrer"
					data-i18n="cta.talkToUs"
					class="rounded-full border-[3px] border-neutral-900 bg-white px-5 py-2.5 text-center font-ibrand text-xs text-neutral-900 transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-black/5 sm:px-11 sm:py-3.5 sm:text-sm dark:border-white dark:bg-neutral-900 dark:text-white dark:hover:bg-white/10"
				>
					Talk to Us
				</a>
			</div>
		</div>

		<div class="mt-14 grid gap-12 lg:grid-cols-3">
			<div>
				<p data-i18n="footer.col.tools" class="font-helvetica text-sm font-semibold text-neutral-900 dark:text-white">Tools</p>
				<ul class="mt-4 flex flex-col gap-3">
					{toolLinks.map((link) => (
						<li>
							<a
								href={link.href}
								data-i18n={link.key}
								class="font-helvetica text-sm text-neutral-600 transition-colors hover:text-primary dark:text-neutral-400 dark:hover:text-primary"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<p data-i18n="footer.col.resources" class="font-helvetica text-sm font-semibold text-neutral-900 dark:text-white">Resources</p>
				<ul class="mt-4 flex flex-col gap-3">
					{resourceLinks.map((link) => (
						<li>
							<a
								href={link.href}
								data-i18n={link.key}
								class="font-helvetica text-sm text-neutral-600 transition-colors hover:text-primary dark:text-neutral-400 dark:hover:text-primary"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<p data-i18n="footer.col.company" class="font-helvetica text-sm font-semibold text-neutral-900 dark:text-white">Company</p>
				<ul class="mt-4 flex flex-col gap-3">
					{companyLinks.map((link) => (
						<li>
							<a
								href={link.href}
								data-i18n={link.key}
								class="font-helvetica text-sm text-neutral-600 transition-colors hover:text-primary dark:text-neutral-400 dark:hover:text-primary"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>

		<div
			class="mt-14 flex flex-col items-center justify-between gap-4 pt-6 font-helvetica text-xs text-neutral-500 sm:flex-row dark:text-neutral-500"
		>
			<p>&copy; {year} Droparabia. <span data-i18n="footer.rights">All rights reserved.</span></p>
			<div class="flex items-center gap-6">
				<a href="/privacy" data-i18n="footer.privacy" class="transition-colors hover:text-primary">Privacy Policy</a>
				<a href="/terms" data-i18n="footer.terms" class="transition-colors hover:text-primary">Terms of Service</a>
			</div>
		</div>
	</div>
</footer>
