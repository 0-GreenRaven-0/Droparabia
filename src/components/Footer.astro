---
import HexBackground from "./HexBackground.astro";
import { ik } from "../lib/imagekit";

// Mirrors the link sets defined in Header.astro (kept as a separate, lighter copy here —
// label/href only, no icons/hex styling needed for a plain footer list).
const toolLinks = [
	{ label: "Find Products", href: "/tools/find-products", key: "tool.find-products.label" },
	{ label: "AI Winning Products", href: "/tools/ai-winning-products", key: "tool.ai-winning-products.label" },
	{ label: "AI Studio", href: "/tools/ai-studio", key: "tool.ai-studio.label" },
	{ label: "Branding", href: "/tools/branding", key: "tool.branding.label" },
	{ label: "Product Request", href: "/tools/product-request", key: "tool.product-request.label" },
	{ label: "Leader Board", href: "/tools/leader-board", key: "tool.leader-board.label" },
];
const resourceLinks = [
	{ label: "FAQ", href: "/faq", key: "resources.faq.label" },
	{ label: "Broadcast channel", href: "https://www.instagram.com/channel/Aba2ifyff8O_0xvs/", key: "resources.broadcast.label" },
	{ label: "Contact", href: "https://ig.me/m/mjbusinessofficial", key: "resources.contact.label" },
	{ label: "About Us", href: "/about", key: "resources.about.label" },
];
const companyLinks = [
	{ label: "Reviews", href: "/reviews", key: "nav.reviews" },
	{ label: "Contact", href: "https://ig.me/m/mjbusinessofficial", key: "nav.contact" },
	{ label: "Dropvault Community", href: "/dropvault", key: "nav.dropvault" },
];

// ChatGPT and Claude both support a `?q=` param that pre-fills a new chat with this prompt —
// confirmed, stable behavior on both. Gemini has no confirmed native equivalent (its web app
// doesn't document one — third-party browser extensions bridge it, but the site can't rely on
// a visitor having one installed), so it links to the plain homepage instead of guessing at a
// param that might silently do nothing.
const AI_PROMPT =
	"I'm researching dropshipping platforms for the Lebanese and MENA market. Explain how Droparabia works for a complete beginner, how Droparabia is different from the traditional e-com model, what features does it have, how can they help me build and scale my online store. Use their website: https://www.droparabia.com";
// Real brand marks, path data from @lobehub/icons-static-svg (MIT-licensed, single-color
// variants) — installed as a devDependency purely to source these paths from, not shipped
// as a runtime dependency.
const aiLinks = [
	{
		label: "ChatGPT",
		href: `https://chatgpt.com/?q=${encodeURIComponent(AI_PROMPT)}`,
		icon: '<path d="M9.205 8.658v-2.26c0-.19.072-.333.238-.428l4.543-2.616c.619-.357 1.356-.523 2.117-.523 2.854 0 4.662 2.212 4.662 4.566 0 .167 0 .357-.024.547l-4.71-2.759a.797.797 0 00-.856 0l-5.97 3.473zm10.609 8.8V12.06c0-.333-.143-.57-.429-.737l-5.97-3.473 1.95-1.118a.433.433 0 01.476 0l4.543 2.617c1.309.76 2.189 2.378 2.189 3.948 0 1.808-1.07 3.473-2.76 4.163zM7.802 12.703l-1.95-1.142c-.167-.095-.239-.238-.239-.428V5.899c0-2.545 1.95-4.472 4.591-4.472 1 0 1.927.333 2.712.928L8.23 5.067c-.285.166-.428.404-.428.737v6.898zM12 15.128l-2.795-1.57v-3.33L12 8.658l2.795 1.57v3.33L12 15.128zm1.796 7.23c-1 0-1.927-.332-2.712-.927l4.686-2.712c.285-.166.428-.404.428-.737v-6.898l1.974 1.142c.167.095.238.238.238.428v5.233c0 2.545-1.974 4.472-4.614 4.472zm-5.637-5.303l-4.544-2.617c-1.308-.761-2.188-2.378-2.188-3.948A4.482 4.482 0 014.21 6.327v5.423c0 .333.143.571.428.738l5.947 3.449-1.95 1.118a.432.432 0 01-.476 0zm-.262 3.9c-2.688 0-4.662-2.021-4.662-4.519 0-.19.024-.38.047-.57l4.686 2.71c.286.167.571.167.856 0l5.97-3.448v2.26c0 .19-.07.333-.237.428l-4.543 2.616c-.619.357-1.356.523-2.117.523zm5.899 2.83a5.947 5.947 0 005.827-4.756C22.287 18.339 24 15.84 24 13.296c0-1.665-.713-3.282-1.998-4.448.119-.5.19-.999.19-1.498 0-3.401-2.759-5.947-5.946-5.947-.642 0-1.26.095-1.88.31A5.962 5.962 0 0010.205 0a5.947 5.947 0 00-5.827 4.757C1.713 5.447 0 7.945 0 10.49c0 1.666.713 3.283 1.998 4.448-.119.5-.19 1-.19 1.499 0 3.401 2.759 5.946 5.946 5.946.642 0 1.26-.095 1.88-.309a5.96 5.96 0 004.162 1.713z"/>',
	},
	{
		label: "Claude",
		href: `https://claude.ai/new?q=${encodeURIComponent(AI_PROMPT)}`,
		icon: '<path d="M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-2.266-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.358-1.596-2.552-1.688-1.336-.972-.724-.491-.364-.462-.158-1.008.656-.722.881.06.225.061.893.686 1.908 1.476 2.491 1.833.365.304.145-.103.019-.073-.164-.274-1.355-2.446-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 01-.104-.729L6.283.134 6.696 0l.996.134.42.364.62 1.414 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.264 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.205-1.657-.851-.747-1.926-1.62h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.012-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312-.006.006z"/>',
	},
	{
		label: "Gemini",
		href: "https://gemini.google.com/",
		icon: '<path d="M20.616 10.835a14.147 14.147 0 01-4.45-3.001 14.111 14.111 0 01-3.678-6.452.503.503 0 00-.975 0 14.134 14.134 0 01-3.679 6.452 14.155 14.155 0 01-4.45 3.001c-.65.28-1.318.505-2.002.678a.502.502 0 000 .975c.684.172 1.35.397 2.002.677a14.147 14.147 0 014.45 3.001 14.112 14.112 0 013.679 6.453.502.502 0 00.975 0c.172-.685.397-1.351.677-2.003a14.145 14.145 0 013.001-4.45 14.113 14.113 0 016.453-3.678.503.503 0 000-.975 13.245 13.245 0 01-2.003-.678z"/>',
	},
];
const year = new Date().getFullYear();

interface Props {
	// The homepage ends with TestimonialsWall, which carries its own heading and CTA — the
	// footer's lockup would just repeat it, so index.astro opts out. Every other page keeps it.
	showCta?: boolean;
}
const { showCta = true } = Astro.props;
---

<footer class="relative overflow-hidden px-6 pt-16 pb-8 lg:px-16">
	<HexBackground cutCorner={false} fadeTop={true} bottomFlush={true} />

	<div class="relative z-10 mx-auto max-w-6xl">
		{showCta && (
			<>
				<a href="/" class="mx-auto flex w-fit items-center gap-4 rtl:flex-row-reverse sm:gap-8">
					<img src={ik("/Droparabia.webp", "w-400,q-80")} alt="Droparabia" class="h-20 w-20 shrink-0 sm:h-32 sm:w-32 lg:h-44 lg:w-44" />
					<h2 data-i18n="footer.cta.heading" class="font-ibrand text-2xl leading-[1.1] text-neutral-900 sm:text-5xl lg:text-6xl dark:text-white">
						<span>Kickstart your <span class="whitespace-nowrap">high-earning</span></span>{" "}
						online store today!
					</h2>
				</a>

				<!-- Final CTA buttons (heading now lives up in the logo lockup above; the tools hex
					 chain that used to sit here was removed). -->
				<div class="mt-6 flex flex-col items-center gap-3 sm:mt-8">
					<div class="flex w-full max-w-xs flex-col items-stretch gap-3 sm:w-auto sm:max-w-none sm:flex-row sm:flex-wrap sm:items-center sm:justify-center sm:gap-4">
						<a
							href="https://calendly.com/d/cr37-8xm-k5s/drop-arabia-strategy-session"
							target="_blank"
							rel="noopener noreferrer"
							class="group inline-flex h-10 items-center justify-center gap-2 rounded-full bg-primary px-6 font-ibrand text-sm text-white shadow-[0_8px_20px_-6px_rgba(0,30,255,0.55)] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-[0_14px_30px_-8px_rgba(0,30,255,0.7)] sm:h-12 sm:px-8 sm:text-base"
						>
							<span data-i18n="cta.getStarted">Get Started</span>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 transition-transform duration-200 ease-out group-hover:translate-x-0.5"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
						</a>
						<a
							href="https://ig.me/m/mjbusinessofficial"
							target="_blank"
							rel="noopener noreferrer"
							data-i18n="cta.talkToUs"
							class="inline-flex h-10 items-center justify-center rounded-full bg-[#e5e4e2] px-6 text-center font-ibrand text-sm text-neutral-900 shadow-[0_8px_20px_-8px_rgba(0,0,0,0.4)] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-[#dcdbd9] hover:shadow-[0_14px_30px_-10px_rgba(0,0,0,0.5)] sm:h-12 sm:px-8 sm:text-base"
						>
							Talk to Us
						</a>
					</div>
				</div>
			</>
		)}

		<div class:list={["grid gap-12 lg:grid-cols-4", showCta ? "mt-14" : "mt-12 sm:mt-16"]}>
			<div>
				<p data-i18n="footer.col.tools" class="font-helvetica text-sm font-semibold text-neutral-900 dark:text-white">Tools</p>
				<ul class="mt-4 flex flex-col gap-3">
					{toolLinks.map((link) => (
						<li>
							<a
								href={link.href}
								target={link.href.startsWith("http") ? "_blank" : undefined}
								rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
								data-i18n={link.key}
								class="font-helvetica text-sm text-neutral-600 transition-colors hover:text-primary dark:text-neutral-400 dark:hover:text-primary"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<p data-i18n="footer.col.resources" class="font-helvetica text-sm font-semibold text-neutral-900 dark:text-white">Resources</p>
				<ul class="mt-4 flex flex-col gap-3">
					{resourceLinks.map((link) => (
						<li>
							<a
								href={link.href}
								target={link.href.startsWith("http") ? "_blank" : undefined}
								rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
								data-i18n={link.key}
								class="font-helvetica text-sm text-neutral-600 transition-colors hover:text-primary dark:text-neutral-400 dark:hover:text-primary"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<p data-i18n="footer.col.company" class="font-helvetica text-sm font-semibold text-neutral-900 dark:text-white">Company</p>
				<ul class="mt-4 flex flex-col gap-3">
					{companyLinks.map((link) => (
						<li>
							<a
								href={link.href}
								target={link.href.startsWith("http") ? "_blank" : undefined}
								rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
								data-i18n={link.key}
								class="font-helvetica text-sm text-neutral-600 transition-colors hover:text-primary dark:text-neutral-400 dark:hover:text-primary"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<p data-i18n="footer.col.askAi" class="font-helvetica text-sm font-semibold text-neutral-900 dark:text-white">Ask AI about us</p>
				<div class="mt-4 flex items-center gap-2.5">
					{aiLinks.map((ai) => (
						<a
							href={ai.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={ai.label}
							title={ai.label}
							class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-black/15 text-neutral-700 transition-all duration-150 ease-out hover:-translate-y-0.5 hover:border-primary hover:text-primary dark:border-white/25 dark:text-neutral-300 dark:hover:text-primary"
						>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" set:html={ai.icon} />
						</a>
					))}
				</div>
			</div>
		</div>

		<div
			class="mt-8 flex flex-col items-center justify-between gap-4 pt-2 font-helvetica text-xs text-neutral-500 sm:flex-row dark:text-neutral-500"
		>
			<p>&copy; {year} Droparabia. <span data-i18n="footer.rights">All rights reserved.</span></p>
			<div class="flex items-center gap-6">
				<a href="/privacy" data-i18n="footer.privacy" class="transition-colors hover:text-primary">Privacy Policy</a>
				<a href="/terms" data-i18n="footer.terms" class="transition-colors hover:text-primary">Terms of Service</a>
			</div>
		</div>
	</div>
</footer>
